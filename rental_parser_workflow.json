{
  "name": "Rental Property Parser - Full Automation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "id": "scheduler",
      "name": "⏰ Schedule Parser (Every 4 hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "command": "cd /home/user/2026/rental_parser && python3 main.py --max-pages 5"
      },
      "id": "run_parser",
      "name": "🏠 Run All Parsers",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "command": "cd /home/user/2026/rental_parser && python3 main.py --extract-phones --phone-limit 20"
      },
      "id": "extract_phones",
      "name": "📞 Extract Phone Numbers",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "command": "cd /home/user/2026/rental_parser && python3 -c \"from database.models import init_db, get_unsent_listings; import json; db = init_db(); listings = get_unsent_listings(db, limit=10); print(json.dumps([{'id': l.id, 'platform': l.platform, 'url': l.url, 'title': l.title, 'price': l.price, 'phone': l.phone, 'address': l.address, 'rooms': l.rooms, 'area': l.area} for l in listings], ensure_ascii=False))\""
      },
      "id": "get_unsent",
      "name": "📋 Get Unsent Listings",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [850, 300]
    },
    {
      "parameters": {
        "fieldName": "listings",
        "fieldValue": "={{ JSON.parse($json.stdout) }}"
      },
      "id": "parse_json",
      "name": "🔧 Parse JSON",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.listings.length }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "check_listings",
      "name": "✅ Has Listings?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "listings",
        "options": {}
      },
      "id": "split_listings",
      "name": "📤 Split Listings",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1450, 200]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "platform_emoji",
              "value": "={{ $json.platform === 'cian' ? '🔵' : ($json.platform === 'yandex' ? '🔴' : '🟢') }}"
            },
            {
              "name": "rooms_text",
              "value": "={{ $json.rooms === 0 ? 'Студия' : ($json.rooms ? $json.rooms + '-комн' : '') }}"
            },
            {
              "name": "message",
              "value": "={{ $json.platform_emoji }} *Новое объявление*\\n\\n*{{ $json.title }}*\\n\\n💰 Цена: {{ $json.price ? $json.price.toFixed(0) + ' ₽/мес' : 'Не указана' }}\\n🏠 {{ $json.rooms_text }}{{ $json.area ? ', ' + $json.area + ' м²' : '' }}\\n📍 {{ $json.address || 'Адрес не указан' }}\\n{{ $json.phone ? '📞 Телефон: `' + $json.phone + '`\\n' : '' }}\\n\\n🔗 [Открыть объявление]({{ $json.url }})\\n\\n_Площадка: {{ $json.platform }}_"
            }
          ]
        },
        "options": {}
      },
      "id": "format_message",
      "name": "✍️ Format Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [1650, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown",
          "disable_web_page_preview": false
        }
      },
      "id": "send_telegram",
      "name": "📱 Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1850, 200],
      "credentials": {
        "telegramApi": {
          "id": "sBegr8MZX7eZ7dIX",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "id": "rate_limit",
      "name": "⏳ Rate Limit (3s)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
      "position": [2050, 200]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.phone }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "has_phone",
      "name": "📞 Has Phone?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [2250, 200]
    },
    {
      "parameters": {
        "url": "={{ $env.AUTO_DIAL_WEBHOOK_URL }}",
        "options": {
          "bodyParametersUi": {
            "parameter": [
              {
                "name": "phone",
                "value": "={{ $json.phone }}"
              },
              {
                "name": "listing_id",
                "value": "={{ $json.id }}"
              },
              {
                "name": "platform",
                "value": "={{ $json.platform }}"
              }
            ]
          }
        }
      },
      "id": "auto_dial",
      "name": "📞 Trigger Auto-Dial",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [2450, 100]
    },
    {
      "parameters": {
        "command": "cd /home/user/2026/rental_parser && python3 -c \"from database.models import init_db, mark_as_sent; db = init_db(); mark_as_sent(db, {{ $json.id }}, 'n8n_workflow'); print('Marked as sent')\""
      },
      "id": "mark_sent",
      "name": "✔️ Mark as Sent",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2650, 200]
    },
    {
      "parameters": {
        "sheetName": "RentalListings",
        "options": {
          "cellFormat": "USER_ENTERED",
          "useAppend": true
        }
      },
      "id": "save_to_sheets",
      "name": "💾 Save to Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 3,
      "position": [2850, 200],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "0h17UZ4QJ4bHSSHp",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "rental-parser-manual",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "manual_trigger",
      "name": "🔧 Manual Trigger (Webhook)",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 500],
      "webhookId": "rental-parser-manual"
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "✅ Парсинг завершен!\\n\\nНайдено новых объявлений: {{ $json.listings.length || 0 }}\\n\\nВремя: {{ $now.toLocaleString('ru-RU') }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "completion_notice",
      "name": "✅ Send Completion Notice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1450, 400],
      "credentials": {
        "telegramApi": {
          "id": "sBegr8MZX7eZ7dIX",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"listings_found\": $json.listings.length || 0 } }}"
      },
      "id": "webhook_response",
      "name": "📤 Webhook Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [450, 500]
    }
  ],
  "connections": {
