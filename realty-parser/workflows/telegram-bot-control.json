    {
      "parameters": {
        "chatId": "={{ $json.message?.chat.id || $json.callback_query?.message.chat.id }}",
        "text": "🏠 **Парсер-Монитор Недвижимости**\n\nДобро пожаловать! Я помогу отслеживать объявления на Авито и ЦИАН.\n\n**Доступные функции:**\n🏠 Парсить Авито - поиск квартир на Авито\n🏢 Парсить ЦИАН - поиск квартир на ЦИАН\n🏘️ Парсить ОБА - поиск на обоих сайтах\n\n⏸️ Остановить / ▶️ Запустить - управление парсингом\n⏰ Автопарсинг - настройка автоматического поиска\n❓ Помощь - связаться с владельцем\n\n**Выберите действие:**",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "🏠 Парсить Авито",
                    "callbackData": "avito_parse"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "🏢 Парсить ЦИАН",
                    "callbackData": "cian_parse"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "🏘️ Парсить ОБА",
                    "callbackData": "both_parse"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "⏸️ Остановить",
                    "callbackData": "stop_parse"
                  },
                  {
                    "text": "▶️ Запустить",
                    "callbackData": "start_parse"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "⏰ Автопарсинг",
                    "callbackData": "auto_settings"
                  }
                ]
              }
            },
            {
              "row": {
                "buttons": [
                  {
                    "text": "❓ Помощь",
                    "callbackData": "help_contact"
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "start-message",
