          "callback_query"
        ]
      },
      "id": "telegram-trigger",
      "name": "📱 Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "position": [
        240,
        300
      ],
      "typeVersion": 1.2,
      "webhookId": "realty-bot-trigger",
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIALS_ID",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.message?.text || $json.callback_query?.data || 'unknown' }}",
        "rules": {
          "rules": [
            {
              "value2": "/start",
              "output": 0
            },
            {
              "value2": "/help",
              "output": 1
            },
            {
              "value2": "/settings",
              "output": 2
            },
            {
              "operation": "startsWith",
              "value2": "avito_",
              "output": 3
            },
            {
              "operation": "startsWith",
              "value2": "cian_",
              "output": 4
            },
            {
              "operation": "startsWith",
              "value2": "both_",
              "output": 5
            },
            {
              "operation": "startsWith",
              "value2": "stop_",
              "output": 6
            },
            {
              "operation": "startsWith",
              "value2": "start_",
              "output": 7
            },
            {
              "operation": "startsWith",
              "value2": "auto_",
              "output": 8
            },
            {
              "operation": "startsWith",
              "value2": "help_",
              "output": 9
            }
          ]
        }
      },
      "id": "router-main",
      "name": "🔀 Router",
