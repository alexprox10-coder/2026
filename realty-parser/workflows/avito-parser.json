      "id": "fetch-avito",
      "name": "📥 Fetch Avito",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        460,
        300
      ],
      "typeVersion": 4.2
    },
    {
      "parameters": {
        "jsCode": "// Парсинг HTML с Avito\n// ПРИМЕЧАНИЕ: Это демо-код. Реальный парсинг требует адаптации под актуальную структуру HTML Avito\n\nconst html = $input.first().json.body || '';\nconst items = [];\n\n// Извлекаем объявления из HTML\n// Avito использует JSON в <script> тегах для передачи данных\nconst scriptMatches = html.match(/<script[^>]*>window\\.__initialState__[\\s\\S]*?<\\/script>/gi);\n\nif (scriptMatches && scriptMatches.length > 0) {\n  try {\n    // Извлекаем JSON данные\n    const scriptContent = scriptMatches[0].replace(/<\\/?script[^>]*>/gi, '');\n    const jsonMatch = scriptContent.match(/window\\.__initialState__\\s*=\\s*(\\{[\\s\\S]+\\});/);\n    \n    if (jsonMatch) {\n      const data = JSON.parse(jsonMatch[1]);\n      \n      // Ищем объявления в структуре данных\n      // Структура может меняться, это пример\n      const listings = data?.items?.items || data?.catalog?.items || [];\n      \n      for (const listing of listings.slice(0, 20)) {\n        items.push({\n          source: 'Avito',\n          title: listing.title || '',\n          price: listing.price?.value || 0,\n          priceText: listing.price?.string || '',\n          address: listing.location?.address || '',\n          url: `https://www.avito.ru${listing.urlPath || ''}`,\n          imageUrl: listing.images?.[0]?.url || '',\n          rooms: listing.params?.rooms || '',\n          area: listing.params?.area || '',\n          floor: listing.params?.floor || '',\n          pubDate: listing.time || new Date().toISOString(),\n          description: listing.description || ''\n        });\n      }\n    }\n  } catch (e) {\n    console.error('Error parsing Avito data:', e.message);\n  }\n}\n\n// Если JSON парсинг не сработал, пробуем регулярные выражения на HTML\nif (items.length === 0) {\n  // Fallback: простой regex парсинг (менее надежный)\n  const titleMatches = html.matchAll(/<h3[^>]*>([^<]+)<\\/h3>/gi);\n  const priceMatches = html.matchAll(/data-marker=\"item-price\"[^>]*>([^<]+)<\\/span>/gi);\n  \n  const titles = Array.from(titleMatches).map(m => m[1].trim());\n  const prices = Array.from(priceMatches).map(m => m[1].trim());\n  \n  for (let i = 0; i < Math.min(titles.length, prices.length, 20); i++) {\n    items.push({\n      source: 'Avito',\n      title: titles[i],\n      price: parseInt(prices[i].replace(/\\D/g, '')) || 0,\n      priceText: prices[i],\n      url: 'https://www.avito.ru',\n      pubDate: new Date().toISOString()\n    });\n  }\n}\n\nif (items.length === 0) {\n  return [{\n    json: {\n      error: 'No items found',\n      message: 'Не удалось найти объявления. Возможно, структура Avito изменилась.'\n    }\n  }];\n}\n\nconsole.log(`Найдено ${items.length} объявлений с Avito`);\nreturn items.map(item => ({ json: item }));"
      },
      "id": "parse-html",
      "name": "🔍 Parse HTML",
      "type": "n8n-nodes-base.code",
      "position": [
        680,
        300
      ],
      "typeVersion": 2
