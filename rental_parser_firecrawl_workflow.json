      "id": "get-details",
      "name": "Get Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1340, 400]
    },
    {
      "parameters": {
        "jsCode": "// Extract details from listing page\nconst items = [];\n\nfor (const item of $input.all()) {\n  const markdown = item.json.data?.markdown || '';\n  const previousData = item.json;\n  \n  // Extract price\n  let price = '';\n  const priceMatch = markdown.match(/([\\d\\s]+)\\s*(?:₽|\\/мес|руб)/i);\n  if (priceMatch) {\n    price = priceMatch[1].replace(/\\s/g, '') + ' ₽/мес';\n  }\n  \n  // Extract phone (Russian format)\n  let phone = '';\n  const phoneMatch = markdown.match(/\\+?[78]?[\\s-]?\\(?\\d{3}\\)?[\\s-]?\\d{3}[\\s-]?\\d{2}[\\s-]?\\d{2}/);\n  if (phoneMatch) {\n    phone = phoneMatch[0].replace(/[^\\d+]/g, '');\n  }\n  \n  // Extract address\n  let address = '';\n  const addressMatch = markdown.match(/(?:адрес|Address|Адрес)[:：]?\\s*([^\\n]{10,100})/i);\n  if (addressMatch) {\n    address = addressMatch[1].trim();\n  }\n  \n  // Extract rooms\n  let rooms = '';\n  const roomsMatch = markdown.match(/(\\d)-комн|студия/i);\n  if (roomsMatch) {\n    rooms = roomsMatch[0];\n  }\n  \n  // Extract area\n  let area = '';\n  const areaMatch = markdown.match(/(\\d+)\\s*м²/);\n  if (areaMatch) {\n    area = areaMatch[0];\n  }\n  \n  // Extract image\n  const html = item.json.data?.html || '';\n  let image = '';\n  const imgMatch = html.match(/<img[^>]+src=\"([^\"]+)\"/);\n  if (imgMatch) {\n    image = imgMatch[1];\n  }\n  \n  items.push({\n    json: {\n      ...previousData,\n      price: price || 'Не указана',\n      phone: phone || 'Не указан',\n      address: address || 'Не указан',\n      rooms: rooms || '—',\n      area: area || '—',\n      image: image || '',\n      title: `${rooms || 'Квартира'} ${area || ''}`.trim()\n    }\n  });\n}\n\nreturn items;"
      },
      "id": "parse-details",
      "name": "Parse Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 400]
