      "id": "get-sent",
      "name": "Get Sent IDs",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [1340, 600],
      "credentials": {
        "sqliteApi": {
          "id": "sqlite-db",
          "name": "Rental Parser DB"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Remove duplicates based on already sent IDs\nconst sentIds = new Set();\n\n// Get all sent IDs from database\nconst sentItems = $('Get Sent IDs').all();\nfor (const item of sentItems) {\n  if (item.json.listing_id) {\n    sentIds.add(item.json.listing_id);\n  }\n}\n\n// Filter out already sent listings\nconst newListings = [];\nfor (const item of $input.all()) {\n  if (!sentIds.has(item.json.id)) {\n    newListings.push(item);\n  }\n}\n\nreturn newListings;"
      },
      "id": "filter-duplicates",
      "name": "Filter Duplicates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 400]
