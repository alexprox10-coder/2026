    {
      "parameters": {
        "method": "POST",
        "url": "https://api.firecrawl.dev/v0/scrape",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer fc-df32f6aa72994d6839e7a87df954d885f"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"url\": \"{{ $json.avitoUrl }}\",\n  \"formats\": [\"markdown\", \"html\"],\n  \"onlyMainContent\": true,\n  \"waitFor\": 3000\n}",
        "options": {}
      },
      "id": "scrape-avito",
      "name": "Scrape Avito",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 600]
    },
    {
      "parameters": {
        "jsCode": "// Extract listings from Firecrawl response\nconst items = [];\n\nfor (const item of $input.all()) {\n  const html = item.json.data?.html || '';\n  const markdown = item.json.data?.markdown || '';\n  const url = item.json.data?.url || '';\n  \n  let platform = 'unknown';\n  if (url.includes('cian.ru')) platform = 'cian';\n  else if (url.includes('yandex.ru')) platform = 'yandex';\n  else if (url.includes('avito.ru')) platform = 'avito';\n  \n  // Parse Cian listings\n  if (platform === 'cian') {\n    const regex = /https:\\/\\/www\\.cian\\.ru\\/rent\\/flat\\/\\d+/g;\n    const urls = [...new Set((html.match(regex) || []))];\n    \n    for (const listingUrl of urls.slice(0, 10)) {\n      const id = listingUrl.match(/\\d+$/)?.[0];\n      items.push({\n        json: {\n          platform: 'Cian',\n          url: listingUrl,\n          id: `cian_${id}`,\n          found_at: new Date().toISOString()\n        }\n      });\n    }\n  }\n  \n  // Parse Yandex listings\n  if (platform === 'yandex') {\n    const regex = /https:\\/\\/realty\\.yandex\\.ru\\/offer\\/\\w+/g;\n    const urls = [...new Set((html.match(regex) || []))];\n    \n    for (const listingUrl of urls.slice(0, 10)) {\n      const id = listingUrl.match(/\\/offer\\/(\\w+)/)?.[1];\n      items.push({\n        json: {\n          platform: 'Yandex',\n          url: listingUrl,\n          id: `yandex_${id}`,\n          found_at: new Date().toISOString()\n        }\n      });\n    }\n  }\n  \n  // Parse Avito listings\n  if (platform === 'avito') {\n    const regex = /https:\\/\\/www\\.avito\\.ru\\/[\\w-]+\\/kvartiry\\/[\\w-]+_\\d+/g;\n    const urls = [...new Set((html.match(regex) || []))];\n    \n    for (const listingUrl of urls.slice(0, 10)) {\n      const id = listingUrl.match(/_(\\d+)$/)?.[1];\n      items.push({\n        json: {\n          platform: 'Avito',\n          url: listingUrl,\n          id: `avito_${id}`,\n          found_at: new Date().toISOString()\n        }\n      });\n    }\n  }\n}\n\nreturn items;"
      },
      "id": "extract-listings",
      "name": "Extract Listings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 400]
