      "id": "f9c06e78-c510-46a5-901f-1d445745f342",
      "name": "Результаты ЦИАН",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        58672,
        17920
      ]
    },
    {
      "parameters": {
        "jsCode": "const firstItem = $input.first();\nconst body = firstItem.json.body;\nconst results = [];\n\nif (!body || (Array.isArray(body) && body.length === 0)) {\n  return [{ json: { empty: true } }];\n}\n\nconst dataArray = Array.isArray(body) ? body : [body];\n\nfor (const listing of dataArray) {\n  if (!listing || typeof listing !== 'object') continue;\n  \n  const url = listing.sourceLink || listing.url || listing.link;\n  if (!url) continue;\n  \n  let price = '';\n  if (listing.priceText) {\n    price = listing.priceText;\n  } else if (listing.price) {\n    price = String(listing.price);\n  }\n  \n  let address = listing.location || listing.address || 'Благовещенск';\n  \n  results.push({\n    json: {\n      id: url,\n      title: listing.title || 'Квартира',\n      price: price,\n      address: address,\n      url: url,\n      source: 'Авито',\n      city: 'Благовещенск',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
      "id": "e1126c94-b067-4ffd-8eb0-53dc52483624",
      "name": "Обработка Авито",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        58896,
        17552
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  let data = item.json.body;\n  \n  if (!data || (Array.isArray(data) && data.length === 0)) continue;\n  \n  const dataArray = Array.isArray(data) ? data : [data];\n  \n  for (const listing of dataArray) {\n    if (!listing || typeof listing !== 'object') continue;\n    \n    const cianId = listing.cianId || listing.id;\n    let url = listing.fullUrl || listing.url || listing.siteUrl;\n    if (!url && cianId) {\n      url = 'https://www.cian.ru/rent/flat/' + cianId + '/';\n    }\n    if (!url) continue;\n    \n    let address = listing.formattedAddress || listing.address || listing.location || 'Благовещенск';\n    if (typeof address === 'object') {\n      address = address.formattedAddress || address.address || 'Благовещенск';\n    }\n    \n    let price = '';\n    if (listing.formattedFullPrice) {\n      price = listing.formattedFullPrice;\n    } else if (listing.bargainTerms && listing.bargainTerms.priceRur) {\n      price = String(listing.bargainTerms.priceRur);\n    } else if (listing.price) {\n      price = String(listing.price);\n    }\n    \n    results.push({\n      json: {\n        id: url,\n        title: listing.title || 'Квартира',\n        price: price,\n        address: address,\n        url: url,\n        source: 'ЦИАН',\n        city: 'Благовещенск',\n        timestamp: new Date().toISOString()\n      }\n    });\n  }\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
      "id": "56f866aa-e1e0-4769-997e-302af1cbcaf7",
      "name": "Обработка ЦИАН",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        58896,
        17920
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst validListings = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (data.empty === true) continue;\n  if (!data.url) continue;\n  validListings.push(item);\n}\n\nreturn validListings;"
      },
