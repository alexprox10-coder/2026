    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const html = item.json;\n    const metadata = item.json;\n    \n    let cleanText = String(html)\n      .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n      .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/&nbsp;/g, ' ')\n      .replace(/&quot;/g, '\"')\n      .replace(/&amp;/g, '&')\n      .replace(/&[a-z]+;/gi, ' ')\n      .replace(/\\s+/g, ' ')\n      .trim();\n    \n    cleanText = cleanText.substring(0, 15000);\n    \n    results.push({\n      json: {\n        site_id: metadata.ID,\n        url: metadata.URL,\n        company_name: metadata['Company Name'],\n        html_text: cleanText,\n        fetch_time: new Date().toISOString()\n      }\n    });\n    \n  } catch (error) {\n    console.error(`Ошибка обработки HTML: ${error.message}`);\n  }\n}\n\nreturn results;"
      },
      "id": "clean-html",
      "name": "🧹 Очистить HTML",
      "type": "n8n-nodes-base.code",
      "position": [1780, 200],
      "typeVersion": 2
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_PERPLEXITY_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": []
        },
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"llama-3.1-sonar-small-128k-online\",\n  messages: [\n    {\n      role: \"system\",\n      content: \"Ты эксперт по извлечению информации о компаниях с их веб-сайтов. Твоя задача: проанализировать текст сайта компании, найти и извлечь ключевую информацию, вернуть структурированный JSON. Требования: все тексты на русском языке, если данные не найдены - возвращай пустые строки, номера телефонов в формате +7 (XXX) XXX-XX-XX, email в валидном формате. Верни ТОЛЬКО валидный JSON без markdown блоков и дополнительного текста.\"\n    },\n    {\n      role: \"user\",\n      content: `Проанализируй текст сайта компании и извлеки следующую информацию:\\n\\n${$json.html_text}\\n\\nИзвлеки данные в JSON формате:\\n- company_name: Название компании\\n- inn: ИНН (если есть)\\n- address: Адрес\\n- phone: Телефон(ы)\\n- email: Email\\n- description: Краткое описание деятельности (2-3 предложения)\\n- products_services: Основные товары/услуги (список)\\n- contact_person: Контактное лицо (если указано)\\n\\nВерни ТОЛЬКО валидный JSON.`\n    }\n  ],\n  temperature: 0.2,\n  max_tokens: 1000\n}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "ai-extract-perplexity",
      "name": "🤖 Perplexity AI",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2000, 200],
      "typeVersion": 4.2,
      "notes": "Perplexity API - $5 бесплатных кредитов\nМодель: llama-3.1-sonar-small-128k-online\nCтоимость: ~$0.20 за 1M токенов",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const response = item.json;\n    const metadata = $('🧹 Очистить HTML').item.json;\n    \n    // Проверка на ошибку API\n    if (response.error) {\n      console.error('Perplexity API Error:', response.error);\n      results.push({\n        json: {\n          site_id: metadata.site_id,\n          url: metadata.url,\n          company_name: metadata.company_name || 'Unknown',\n          inn: '',\n          address: '',\n          phone: '',\n          email: '',\n          description: '',\n          products_services: '',\n          contact_person: '',\n          error: response.error.message\n        }\n      });\n      continue;\n    }\n    \n    // Извлекаем текст ответа от AI\n    let aiContent = response.choices?.[0]?.message?.content || '{}';\n    \n    // Очищаем от markdown блоков если есть\n    aiContent = aiContent.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    \n    // Парсим JSON\n    let extractedData = {};\n    try {\n      extractedData = JSON.parse(aiContent);\n    } catch (parseError) {\n      console.error('JSON parse error:', parseError.message);\n      console.log('AI Content:', aiContent);\n      // Если не удалось распарсить - используем пустые значения\n      extractedData = {};\n    }\n    \n    results.push({\n      json: {\n        site_id: metadata.site_id,\n        url: metadata.url,\n        company_name: extractedData.company_name || metadata.company_name || 'Unknown',\n        inn: extractedData.inn || '',\n        address: extractedData.address || '',\n        phone: extractedData.phone || '',\n        email: extractedData.email || '',\n        description: extractedData.description || '',\n        products_services: extractedData.products_services || '',\n        contact_person: extractedData.contact_person || '',\n        raw_ai_response: aiContent\n      }\n    });\n    \n  } catch (error) {\n    console.error(`Error processing AI response: ${error.message}`);\n  }\n}\n\nreturn results;"
      },
      "id": "parse-ai-response",
      "name": "🔧 Парсинг ответа AI",
      "type": "n8n-nodes-base.code",
