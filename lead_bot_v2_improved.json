      "id": "node-merge",
      "name": "Объединить данные",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1060, 460]
    },
    {
      "parameters": {
        "jsCode": "// =============================================\n// КОНФИГУРАЦИЯ ЦЕН (дублируем для расчетов)\n// =============================================\nconst PRICING_CONFIG = {\n  plan_day: { duration_days: 1, amount: 49000 },\n  plan_week: { duration_days: 7, amount: 149000 },\n  plan_month: { duration_days: 30, amount: 399000 }\n};\n\n// =============================================\n// БЛОК 2: Определение состояния пользователя\n// =============================================\nconst inputData = $input.all();\n\n// Данные из Extract node\nconst tgData = inputData[0] ? inputData[0].json : {};\n\n// Данные из Google Sheets - обрабатываем случай когда пустой ответ\nlet userData = {};\nif (inputData[1] && inputData[1].json) {\n  // Проверяем что это не пустой объект от ошибки\n  const gsData = inputData[1].json;\n  if (gsData.user_id || gsData.state) {\n    userData = gsData;\n  }\n}\n\n// Определяем состояние\nlet state = userData.state || 'new';\n\n// Обработка специальных типов обновлений\nif (tgData.updateType === 'pre_checkout') {\n  state = 'pre_checkout';\n} else if (tgData.updateType === 'successful_payment') {\n  state = 'payment_success';\n} else if (tgData.messageText === '/start') {\n  state = 'new';\n} else if (tgData.messageText === '/status' || tgData.messageText === 'status') {\n  state = 'check_status';  // ДОБАВЛЕНО: обработка /status\n} else if (tgData.messageText === '/help') {\n  state = 'show_help';\n}\n\n// Если у нас callback_query с префиксом\nif (tgData.callbackData) {\n  if (tgData.callbackData.startsWith('niche_')) state = 'niche_selected';\n  if (tgData.callbackData.startsWith('region_')) state = 'region_selected';\n  if (tgData.callbackData.startsWith('plan_')) state = 'plan_selected';\n  if (tgData.callbackData.startsWith('notif_')) state = 'notif_selected';\n}\n\n// Проверяем не истекла ли подписка\nlet subscriptionActive = false;\nlet daysRemaining = 0;\nif (userData.expires_at) {\n  const expiresAt = new Date(userData.expires_at);\n  const now = new Date();\n  subscriptionActive = expiresAt > now;\n  if (subscriptionActive) {\n    daysRemaining = Math.ceil((expiresAt - now) / (1000 * 60 * 60 * 24));\n  }\n}\n\nreturn [{\n  json: {\n    ...tgData,\n    // Данные пользователя из БД\n    dbState: userData.state || '',\n    dbNiche: userData.niche || '',\n    dbRegion: userData.region || '',\n    dbPlan: userData.plan || '',\n    dbCompany: userData.company || '',\n    dbKeywords: userData.keywords || '',\n    dbNotifications: userData.notifications || '',\n    dbExpiresAt: userData.expires_at || '',\n    subscriptionActive,\n    daysRemaining,\n    // Текущее состояние для роутинга\n    currentState: state,\n    isNewUser: !userData.user_id,\n    // Конфигурация цен\n    pricingConfig: PRICING_CONFIG\n  }\n}];"
      },
      "id": "node-resolve-state",
      "name": "Определить состояние",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1280, 460]
    },
