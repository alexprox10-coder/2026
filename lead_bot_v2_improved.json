      "id": "node-tg-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 460],
      "webhookId": "lead-bot-main",
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_TELEGRAM_CRED_ID",
          "name": "Telegram Bot API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// =============================================\n// КОНФИГУРАЦИЯ ЦЕН (единственное место!)\n// =============================================\nconst PRICING_CONFIG = {\n  plan_day: {\n    name: '1 День',\n    emoji: '⚡',\n    description: 'Доступ к горячим лидам на 24 часа',\n    amount: 49000,\n    duration_days: 1,\n    label: '1 День — 490 ₽',\n    buttonText: '⚡ 1 День — 490 ₽'\n  },\n  plan_week: {\n    name: '1 Неделя',\n    emoji: '🔥',\n    description: 'Доступ к горячим лидам на 7 дней + настройка фильтров',\n    amount: 149000,\n    duration_days: 7,\n    label: '1 Неделя — 1 490 ₽',\n    buttonText: '🔥 1 Неделя — 1 490 ₽'\n  },\n  plan_month: {\n    name: '1 Месяц',\n    emoji: '💎',\n    description: 'Доступ к горячим лидам на 30 дней + персональный парсер + приоритет',\n    amount: 399000,\n    duration_days: 30,\n    label: '1 Месяц — 3 990 ₽',\n    buttonText: '💎 1 Месяц — 3 990 ₽ (выгодно!)'\n  }\n};\n\n// =============================================\n// БЛОК 1: Извлечение данных из Telegram Update\n// =============================================\nconst update = $input.first().json;\n\nlet userId = null;\nlet username = '';\nlet firstName = '';\nlet messageText = '';\nlet callbackData = '';\nlet updateType = '';\nlet chatId = null;\nlet callbackQueryId = '';\nlet preCheckoutQueryId = '';\n\ntry {\n  if (update.callback_query) {\n    updateType = 'callback_query';\n    userId = String(update.callback_query.from.id);\n    chatId = String(update.callback_query.message.chat.id);\n    username = update.callback_query.from.username || '';\n    firstName = update.callback_query.from.first_name || '';\n    callbackData = update.callback_query.data || '';\n    messageText = callbackData;\n    callbackQueryId = update.callback_query.id;\n\n  } else if (update.pre_checkout_query) {\n    updateType = 'pre_checkout';\n    userId = String(update.pre_checkout_query.from.id);\n    chatId = userId;\n    username = update.pre_checkout_query.from.username || '';\n    firstName = update.pre_checkout_query.from.first_name || '';\n    messageText = update.pre_checkout_query.invoice_payload || '';\n    preCheckoutQueryId = update.pre_checkout_query.id;\n\n  } else if (update.message) {\n    chatId = String(update.message.chat.id);\n    userId = String(update.message.from.id);\n    username = update.message.from.username || '';\n    firstName = update.message.from.first_name || '';\n\n    if (update.message.successful_payment) {\n      updateType = 'successful_payment';\n      messageText = update.message.successful_payment.invoice_payload || '';\n    } else {\n      updateType = 'message';\n      messageText = update.message.text || '';\n    }\n  }\n} catch(e) {\n  return [];\n}\n\nif (!userId) return [];\n\n// Генерируем динамические кнопки тарифов\nconst planButtons = Object.entries(PRICING_CONFIG).map(([key, plan]) => ({\n  text: plan.buttonText,\n  callback_data: key\n}));\n\nconst planKeyboard = JSON.stringify({\n  inline_keyboard: planButtons.map(btn => [btn])\n});\n\nreturn [{\n  json: {\n    userId,\n    chatId: chatId || userId,\n    username,\n    firstName,\n    displayName: username ? '@' + username : firstName,\n    messageText,\n    callbackData,\n    updateType,\n    callbackQueryId,\n    preCheckoutQueryId,\n    rawUpdate: update,\n    // Конфигурация цен для передачи дальше\n    pricingConfig: PRICING_CONFIG,\n    planKeyboard\n  }\n}];"
      },
      "id": "node-extract-data",
      "name": "Извлечь данные",
