    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst nicheMap = {\n  'niche_repair': 'Ремонт и строительство',\n  'niche_legal': 'Юридические услуги',\n  'niche_auto': 'Автосервис',\n  'niche_medical': 'Медицина/Стоматология',\n  'niche_realty': 'Недвижимость',\n  'niche_beauty': 'Красота/Spa',\n  'niche_b2b': 'B2B/Бизнес',\n  'niche_other': 'Другое'\n};\n\nreturn [{\n  json: {\n    ...d,\n    selectedNiche: nicheMap[d.callbackData] || d.callbackData,\n    nicheCode: d.callbackData\n  }\n}];"
      },
