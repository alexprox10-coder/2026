# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# For agent mode: comma-separated list of chat IDs
TELEGRAM_CHAT_IDS=123456789,987654321

# Database
DB_PATH=rental_parser.db

# Auto-dial webhook (optional)
# If you have a telephony service that accepts webhooks
AUTO_DIAL_WEBHOOK_URL=https://your-autodial-service.com/webhook

# Proxy configuration file (optional)
PROXY_FILE=proxies.txt

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/parser.log

# Parsing settings
DEFAULT_CITY=москва
MAX_PAGES_PER_PLATFORM=5
PHONE_EXTRACTION_LIMIT=20

# n8n configuration (if using webhook trigger)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/rental-parser-manual
N8N_API_KEY=your_n8n_api_key

# =============================================
# AGENT MODE CONFIGURATION
# =============================================

# City to parse (default: москва)
CITY=москва

# How often to parse (in hours, default: 4)
PARSE_INTERVAL_HOURS=4

# Maximum pages to parse per platform (default: 5)
MAX_PAGES=5

# Enable auto-dial feature (true/false, default: true)
AUTO_DIAL_ENABLED=true

# Auto-dial backend (webhook/asterisk/twilio/mock)
DIALER_BACKEND=mock

# Webhook dialer configuration
DIALER_WEBHOOK_URL=https://your-telephony-system.com/api/dial

# Asterisk AMI configuration
ASTERISK_HOST=localhost
ASTERISK_PORT=5038
ASTERISK_USER=admin
ASTERISK_PASSWORD=your_password

# Twilio configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15551234567
TWILIO_TWIML_URL=https://your-server.com/twiml/rental-call.xml
TWILIO_STATUS_CALLBACK_URL=https://your-server.com/api/twilio/status
