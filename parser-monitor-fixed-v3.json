    {
      "parameters": {
        "jsCode": "// Обрабатываем результаты Авито\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data || !data.url) continue;\n  \n  // Извлекаем адрес из всех возможных полей\n  let address = 'Адрес не указан';\n  if (data.address && data.address !== '') {\n    address = data.address;\n  } else if (data.location && data.location !== '') {\n    address = data.location;\n  } else if (data.geo && data.geo.address) {\n    address = data.geo.address;\n  } else if (data.locationName) {\n    address = data.locationName;\n  }\n  \n  // Извлекаем цену\n  let price = 'Цена не указана';\n  if (data.price && data.price !== '') {\n    price = data.price;\n  } else if (data.priceNum) {\n    price = data.priceNum + ' ₽';\n  } else if (data.priceValue) {\n    price = data.priceValue + ' ₽';\n  }\n  \n  results.push({\n    json: {\n      id: data.url,\n      title: data.title || 'Квартира',\n      price: price,\n      address: address,\n      url: data.url,\n      source: 'Авито',\n      city: 'Благовещенск',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
      "id": "313066bb-50ac-4aa6-8ab3-23f5552e2466",
      "name": "Обработка Авито",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// Обрабатываем результаты ЦИАН\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data) continue;\n  \n  // ЦИАН использует поле siteUrl или строим URL из cianId\n  const cianId = data.cianId || data.id;\n  const url = data.siteUrl || data.url || (cianId ? `https://www.cian.ru/rent/flat/${cianId}/` : null);\n  \n  if (!url) continue;\n  \n  // Получаем адрес\n  let address = 'Адрес не указан';\n  if (data.formattedAddress) {\n    address = data.formattedAddress;\n  } else if (data.address) {\n    address = data.address;\n  } else if (data.geo && data.geo.address) {\n    address = data.geo.address;\n  }\n  \n  // Получаем цену\n  let price = 'Цена не указана';\n  if (data.formattedFullPrice) {\n    price = data.formattedFullPrice;\n  } else if (data.price) {\n    price = data.price;\n  } else if (data.priceValue) {\n    price = data.priceValue + ' ₽';\n  }\n  \n  results.push({\n    json: {\n      id: url,\n      title: data.title || 'Квартира',\n      price: price,\n      address: address,\n      url: url,\n      source: 'ЦИАН',\n      city: 'Благовещенск',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
      "id": "66e50ee2-a25c-40b3-9617-8ebf99b154a2",
      "name": "Обработка ЦИАН",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
