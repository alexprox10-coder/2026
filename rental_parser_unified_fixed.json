    {
      "parameters": {
        "jsCode": "const platform = $json.platform || 'unknown';\nconst platformEmoji = platform === 'cian' ? '🔵' : (platform === 'yandex' ? '🔴' : '🟢');\nconst platformName = platform === 'cian' ? 'Cian.ru' : (platform === 'yandex' ? 'Yandex.Realty' : 'Avito.ru');\n\nconst roomsText = $json.rooms === 0 ? 'Студия' : ($json.rooms ? `${$json.rooms}-комн` : '');\nconst priceText = $json.price ? `${Math.round($json.price).toLocaleString('ru-RU')} ₽/мес` : 'Цена не указана';\n\nconst message = `${platformEmoji} *Новое объявление - ${platformName}*\\n\\n*${$json.title}*\\n\\n💰 ${priceText}\\n${roomsText ? '🏠 ' + roomsText : ''}${$json.area ? (roomsText ? ', ' : '📐 ') + $json.area + ' м²' : ''}\\n${$json.address ? '📍 ' + $json.address : ''}\\n${$json.phone ? '📞 \\`' + $json.phone + '\\`' : '📞 Телефон не указан'}\\n\\n🔗 [Открыть объявление](${$json.url})\\n\\n_Площадка: ${platformName}_`;\n\nreturn {\n  json: {\n    ...($json),\n    message: message,\n    platform_emoji: platformEmoji,\n    platform_name: platformName\n  }\n};"
      },
