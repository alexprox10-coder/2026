# ==============================================
# n8n TELEGRAM BOT ENVIRONMENT VARIABLES
# ==============================================
# Скопируйте этот файл в .env и заполните значения
# ==============================================

# ==============================================
# N8N CONFIGURATION
# ==============================================

# URL вашего n8n инстанса (без trailing slash)
# Примеры:
#   - Production: https://n8n.yourdomain.com
#   - Local: http://localhost:5678
#   - n8n Cloud: https://your-name.app.n8n.cloud
N8N_HOST=https://your-n8n-instance.com

# n8n API Key (создайте в Settings → API)
# Формат: n8n_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
N8N_API_KEY=your_n8n_api_key_here

# ==============================================
# TELEGRAM BOT CONFIGURATION
# ==============================================

# Telegram Bot Token (получите у @BotFather)
# Формат: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID пользователя, который имеет доступ к боту
# Узнайте свой ID через @userinfobot
TELEGRAM_OWNER_USER_ID=7984101063

# Chat ID администратора для получения отзывов
# Обычно совпадает с TELEGRAM_OWNER_USER_ID
TELEGRAM_ADMIN_CHAT_ID=7984101063

# ==============================================
# PARSER WORKFLOW CONFIGURATION
# ==============================================

# ID главного workflow парсера недвижимости
# Найдите ID в URL workflow: /workflow/{ID}
PARSER_WORKFLOW_ID=iXAfySHKjPj3DPcm

# ==============================================
# OPTIONAL: DOCKER CONFIGURATION
# ==============================================

# Если используете Docker для n8n, раскомментируйте:

# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=your_secure_password

# N8N_ENCRYPTION_KEY=your_encryption_key_here

# Webhook URL для Telegram (обычно генерируется автоматически)
# WEBHOOK_URL=https://your-n8n-instance.com/webhook/telegram

# ==============================================
# NOTES
# ==============================================
#
# 1. Все переменные N8N_* должны быть добавлены в:
#    - n8n Cloud: Settings → Environment Variables
#    - Self-hosted: docker-compose.yml или .env файл
#
# 2. После изменения переменных перезапустите n8n:
#    docker restart n8n (для Docker)
#    или перезагрузите n8n Cloud workspace
#
# 3. TELEGRAM_BOT_TOKEN используется в Credentials n8n
#    (не добавляется напрямую в Environment Variables)
#
# 4. Проверьте, что все ID и токены корректны перед запуском
#
# ==============================================
