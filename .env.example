# Crypto Leads Parser - Environment Variables

# Telegram API (обязательно для Telethon)
# Получить на https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+7XXXXXXXXXX

# Telegram Webhook для уведомлений (опционально)
TELEGRAM_WEBHOOK_URL=https://api.telegram.org/bot<YOUR_BOT_TOKEN>/sendMessage
TELEGRAM_CHAT_ID=your_chat_id

# Прокси для обхода блокировок (опционально)
PROXY_URL=http://user:pass@proxy:port
