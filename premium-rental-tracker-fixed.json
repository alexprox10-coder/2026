    {
      "parameters": {
        "jsCode": "const data = $('Analyze Rental Seekers').item.json;\nconst output = data.output || {};\n\nlet insights = '';\nif (output.keyInsights && Array.isArray(output.keyInsights)) {\n  insights = output.keyInsights.map((s, i) => (i + 1) + '. ' + s).join('\\n');\n}\n\nconst msg = 'Квалифицированный лид найден!\\n\\n' +\n  'Пользователь: ' + (data.userName || 'Не указано') + '\\n' +\n  'Оценка срочности: ' + (output.urgencyScore || 0) + '/10\\n' +\n  'Средняя цена: ' + (data.avgPrice || 0) + ' руб/мес\\n' +\n  'Количество поисков: ' + (data.searchCount || 0) + '\\n' +\n  'Адрес: ' + (data.address || 'Не указан') + '\\n' +\n  'Платформы: ' + (data.platforms || '') + '\\n\\n' +\n  'Контакты:\\n' +\n  'Телефон: ' + (data.phone || 'Не указан') + '\\n' +\n  'Email: ' + (data.email || 'Не указан') + '\\n\\n' +\n  'Рекомендация: ' + (output.recommendation || '') + '\\n\\n' +\n  'Ключевые инсайты:\\n' + insights + '\\n\\n' +\n  (data.profileUrl || '');\n\nreturn [{ json: { message: msg } }];"
      },
