      "id": "cian-results-node",
      "name": "Get CIAN Results",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [224, 192]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data || !data.url) continue;\n  \n  let cleanUrl = data.url.split('?')[0];\n  \n  let price = '';\n  if (data.price) {\n    if (typeof data.price === 'string') {\n      const nums = data.price.match(/\\d+/g);\n      if (nums) price = nums.join('');\n    } else if (typeof data.price === 'number') {\n      price = data.price.toString();\n    }\n  }\n  if (!price) price = '0';\n  \n  let address = data.address || data.location || '';\n  if (data.geo) address = data.geo.address || data.geo.formattedAddress || address;\n  if (!address) address = 'Благовещенск';\n  \n  results.push({\n    json: {\n      userId: data.userId || data.authorId || data.sellerId || 'unknown',\n      userName: data.userName || data.authorName || data.sellerName || 'Не указано',\n      price: parseInt(price) || 0,\n      searchDate: new Date().toISOString(),\n      platform: 'Avito',\n      profileUrl: cleanUrl,\n      phone: data.phone || data.phoneNumber || '',\n      email: data.email || '',\n      address: address\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "7880372d-a6aa-4cb7-97cd-3b614b43508a",
      "name": "Transform Avito Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [448, 0]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data) continue;\n  \n  const cianId = data.cianId || data.id;\n  let url = data.siteUrl || data.url || (cianId ? 'https://www.cian.ru/rent/flat/' + cianId + '/' : '');\n  if (!url) continue;\n  url = url.split('?')[0];\n  \n  let address = data.formattedAddress || data.address || '';\n  if (data.geo) address = data.geo.address || data.geo.formattedAddress || address;\n  if (!address) address = 'Благовещенск';\n  \n  let price = 0;\n  if (data.formattedFullPrice) {\n    const nums = data.formattedFullPrice.match(/\\d+/g);\n    if (nums) price = parseInt(nums.join(''));\n  } else if (data.price) {\n    price = typeof data.price === 'number' ? data.price : parseInt(data.price) || 0;\n  } else if (data.bargainTerms && data.bargainTerms.price) {\n    price = data.bargainTerms.price;\n  }\n  \n  results.push({\n    json: {\n      userId: data.userId || data.authorId || data.ownerId || 'unknown',\n      userName: data.userName || data.authorName || data.ownerName || 'Не указано',\n      price: price,\n      searchDate: new Date().toISOString(),\n      platform: 'CIAN',\n      profileUrl: url,\n      phone: data.phone || data.phoneNumber || '',\n      email: data.email || '',\n      address: address\n    }\n  });\n}\n\nreturn results;"
      },
