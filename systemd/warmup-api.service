[Unit]
Description=Warmup API - отправка первых сообщений лидам
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/2026
ExecStart=/usr/bin/python3 /root/2026/warmup_api.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
