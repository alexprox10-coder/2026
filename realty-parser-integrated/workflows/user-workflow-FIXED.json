    {
      "parameters": {
        "jsCode": "// Обрабатываем результаты Авито\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data || !data.url) continue;\n  \n  results.push({\n    json: {\n      id: data.url,\n      title: data.title || 'Квартира',\n      price: data.price || data.priceNum || 'Цена не указана',\n      address: data.address || data.location || 'Адрес не указан',\n      url: data.url,\n      image: data.image || data.imageUrl || data.images?.[0] || null,\n      source: 'Авито',\n      city: 'Благовещенск',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
      "id": "2d1a4cec-c8a3-4367-8cfd-90e5dae408a2",
      "name": "Обработка Авито",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Обрабатываем результаты ЦИАН\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data) continue;\n  \n  // ЦИАН использует поле siteUrl или строим URL из cianId\n  const cianId = data.cianId || data.id;\n  const url = data.siteUrl || data.url || (cianId ? `https://www.cian.ru/rent/flat/${cianId}/` : null);\n  \n  if (!url) continue;\n  \n  // Получаем адрес\n  const address = data.formattedAddress || data.address || data.geo?.address || 'Адрес не указан';\n  \n  // Получаем цену\n  const price = data.formattedFullPrice || data.price || data.priceValue || 'Цена не указана';\n  \n  // Получаем фото\n  const image = data.mainImage?.full || data.image || data.photo || (data.photos && data.photos[0]) || null;\n  \n  results.push({\n    json: {\n      id: url,\n      title: data.title || 'Квартира',\n      price: price,\n      address: address,\n      url: url,\n      image: image,\n      source: 'ЦИАН',\n      city: 'Благовещенск',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
      "id": "390889e6-7890-4c88-a929-0bc91a0350a4",
      "name": "Обработка ЦИАН",
