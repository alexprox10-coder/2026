    {
      "parameters": {
        "jsCode": "// Убеждаемся, что данные прошли правильно\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n\n  // Пропускаем пустые объекты\n  if (data.empty) continue;\n\n  // Проверяем, что есть необходимые поля\n  if (!data.url && !data.id) continue;\n\n  results.push({\n    json: {\n      id: data.id || data.url,\n      title: data.title || 'Объявление',\n      price: data.price || 'Цена не указана',\n      address: data.address || 'Адрес не указан',\n      url: data.url,\n      image: data.image || null,\n      source: data.source || 'Неизвестный источник',\n      city: data.city || 'Благовещенск',\n      timestamp: data.timestamp || new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
