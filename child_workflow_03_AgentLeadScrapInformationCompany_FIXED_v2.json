    {
      "parameters": {
        "jsCode": "// Собрать статистику по обработанным компаниям\nconst allItems = $input.all();\n\nlet totalProcessed = 0;\nlet withPhone = 0;\nlet withEmail = 0;\nlet failed = 0;\n\nconst companies = [];\n\nfor (const item of allItems) {\n  if (item.json.company_name) {\n    totalProcessed++;\n    if (item.json.phone) withPhone++;\n    if (item.json.email) withEmail++;\n    if (item.json.description === 'Ошибка загрузки сайта') failed++;\n    \n    companies.push({\n      name: item.json.company_name,\n      website: item.json.website,\n      phone: item.json.phone || 'не найден',\n      email: item.json.email || 'не найден'\n    });\n  }\n}\n\nreturn {\n  json: {\n    status: 'success',\n    message: `Обработано компаний: ${totalProcessed}. С телефоном: ${withPhone}. С email: ${withEmail}. Ошибок: ${failed}.`,\n    total_processed: totalProcessed,\n    with_phone: withPhone,\n    with_email: withEmail,\n    failed: failed,\n    companies: companies\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
