        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 2048,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Проанализируй HTML код сайта компании и извлеки следующую информацию:\\n\\n1. Телефон (все найденные номера через запятую)\\n2. Email (все найденные email через запятую)\\n3. Краткое описание компании (1-2 предложения)\\n\\nHTML код (первые 15000 символов):\\n\\n{{ $('Загрузить HTML сайта').item.json.data.substring(0, 15000) }}\\n\\nВерни результат СТРОГО в JSON формате:\\n{\\n  \\\"phone\\\": \\\"телефон или пусто\\\",\\n  \\\"email\\\": \\\"email или пусто\\\",\\n  \\\"description\\\": \\\"описание\\\"\\n}\\n\\nВАЖНО:\\n- Если не найдено - пустая строка\\n- Только JSON, без комментариев\\n- Ищи телефон в форматах: +7, 8, (код) номер\\n- Ищи email с @\\n- Описание из meta description или заголовков\"\n    }\n  ]\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        200
      ],
      "id": "claude-scrape-305",
      "name": "Claude - Парсинг HTML",
      "credentials": {
        "anthropicApi": {
          "id": "FqPSgI0tNpkjQj2R",
          "name": "Anthropic account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Извлечь JSON из ответа Claude\nconst response = $input.first().json;\nconst content = response.content[0].text;\n\n// Попытаться распарсить JSON\nlet companyData = {\n  phone: '',\n  email: '',\n  description: ''\n};\n\ntry {\n  // Извлечь JSON из возможного markdown блока\n  const jsonMatch = content.match(/\\{[\\s\\S]*\\}/);\n  if (jsonMatch) {\n    companyData = JSON.parse(jsonMatch[0]);\n  }\n} catch (error) {\n  console.error('Error parsing JSON:', error);\n}\n\n// Получить данные из предыдущего узла\nconst previousData = $('Цикл по компаниям').item.json;\n\nreturn {\n  json: {\n    row_number: previousData.row_number || 0,\n    website: previousData.Сайт || previousData.website || '',\n    company_name: previousData.Компания || previousData.company_name || '',\n    phone: companyData.phone || '',\n    email: companyData.email || '',\n    description: companyData.description || '',\n    status: 1\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        200
      ],
