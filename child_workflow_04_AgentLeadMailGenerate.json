      "position": [
        240,
        400
      ],
      "webhookId": "generate-proposals-webhook",
      "typeVersion": 2
    },
    {
      "parameters": {
        "operation": "search",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_GOOGLE_SHEET_ID_HERE"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "CompanyInformation"
        },
        "filtersUI": {
          "values": []
        },
        "options": {
          "valueRenderMode": "UNFORMATTED_VALUE"
        }
      },
      "id": "get-companies",
      "name": "📋 Получить компании",
      "type": "n8n-nodes-base.googleSheets",
      "position": [
        460,
        400
      ],
      "typeVersion": 4.7,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "0h17UZ4QJ4bHSSHp",
          "name": "ПАРС ТГ НОВОСТИ"
        }
      },
      "notes": "Получает все компании с собранными данными"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-email",
              "leftValue": "={{ $json.Email }}",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-has-email",
      "name": "✉️ Есть email?",
      "type": "n8n-nodes-base.if",
      "position": [
        680,
        400
      ],
      "typeVersion": 2.2
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\n\nconst yourCompanyInfo = {\n  name: 'Ваша Компания',\n  service: 'ваша услуга/продукт',\n  benefits: 'ключевые преимущества',\n  contactPerson: 'Ваше Имя',\n  position: 'Ваша Должность',\n  phone: '+7 (999) 123-45-67',\n  website: 'https://your-company.ru'\n};\n\nconst templateData = {\n  // Данные получателя\n  recipient_company: item['Company Name'] || 'Компания',\n  recipient_contact: item['Contact Person'] || 'Уважаемый(ая) коллега',\n  recipient_email: item['Email'],\n  recipient_phone: item['Phone'],\n  recipient_address: item['Address'],\n  recipient_description: item['Description'],\n  recipient_services: item['Products/Services'],\n  \n  // Данные вашей компании\n  sender_company: yourCompanyInfo.name,\n  sender_service: yourCompanyInfo.service,\n  sender_benefits: yourCompanyInfo.benefits,\n  sender_contact: yourCompanyInfo.contactPerson,\n  sender_position: yourCompanyInfo.position,\n  sender_phone: yourCompanyInfo.phone,\n  sender_website: yourCompanyInfo.website,\n  \n  // Мета-данные\n  site_id: item['Site ID'],\n  generated_at: new Date().toISOString()\n};\n\nreturn { json: templateData };"
      },
      "id": "prepare-template-data",
      "name": "📝 Подготовить данные для шаблона",
      "type": "n8n-nodes-base.code",
      "position": [
        900,
        300
      ],
      "typeVersion": 2,
      "notes": "Измените данные yourCompanyInfo на свои!"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Создай персональное коммерческое предложение для компании.\\n\\nИнформация о получателе:\\n- Компания: ' + $json.recipient_company + '\\n- Контактное лицо: ' + $json.recipient_contact + '\\n- Деятельность: ' + $json.recipient_description + '\\n- Услуги/товары: ' + $json.recipient_services + '\\n- Адрес: ' + $json.recipient_address + '\\n\\nИнформация об отправителе:\\n- Компания: ' + $json.sender_company + '\\n- Услуга/продукт: ' + $json.sender_service + '\\n- Преимущества: ' + $json.sender_benefits + '\\n- Контакт: ' + $json.sender_contact + ', ' + $json.sender_position + '\\n- Телефон: ' + $json.sender_phone + '\\n- Сайт: ' + $json.sender_website + '\\n\\nСоздай профессиональное коммерческое предложение:\\n\\n1. ТЕМА ПИСЬМА (subject): Краткая и цепляющая (до 60 символов)\\n2. ТЕКСТ ПИСЬМА (body): \\n   - Персонализированное обращение\\n   - Показать понимание специфики их бизнеса\\n   - Четко объяснить ценность предложения\\n   - Конкретные выгоды для их компании\\n   - Призыв к действию\\n   - Профессиональная подпись\\n\\nВерни JSON:\\n{\\n  \"subject\": \"Тема письма\",\\n  \"body\": \"Текст письма в формате HTML\"\\n}\\n\\nТребования:\\n- Текст на русском языке\\n- HTML форматирование (p, br, strong, ul, li)\\n- Длина: 200-300 слов\\n- Тон: профессиональный, дружелюбный' }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Ты эксперт по созданию персонализированных коммерческих предложений B2B.\n\nТвоя задача:\n1. Проанализировать информацию о компании-получателе\n2. Создать уникальное предложение, учитывающее их специфику\n3. Подчеркнуть конкретные выгоды для их бизнеса\n4. Сделать письмо привлекательным и побуждающим к действию\n\nСтиль:\n- Профессиональный, но не формальный\n- Персонализированный\n- Ориентированный на выгоды получателя\n- Четкий call-to-action"
        }
      },
      "id": "ai-generate-proposal",
      "name": "🤖 AI Генерация предложения",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "position": [
        1120,
        300
      ],
      "typeVersion": 3.1
    },
    {
      "parameters": {
        "model": "gemini-1.5-flash",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1040,
        500
      ],
      "id": "ai-model-gemini",
      "name": "✨ Google Gemini",
      "credentials": {
        "googleGeminiApi": {
          "id": "YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\"type\":\"object\",\"properties\":{\"subject\":{\"type\":\"string\"},\"body\":{\"type\":\"string\"}},\"required\":[\"subject\",\"body\"]}",
        "autoFix": true
      },
      "id": "json-parser",
      "name": "🔧 JSON Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "position": [
        1040,
        700
      ],
      "typeVersion": 1.3
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "site_id",
