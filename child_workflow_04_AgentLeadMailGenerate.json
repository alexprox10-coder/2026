        "jsCode": "// Подсчитываем количество компаний для генерации писем\nconst companies = $input.all().map(item => item.json);\nconst count = companies.length;\n\nreturn {\n  json: {\n    companies_to_generate: count,\n    companies_list: companies.map(c => ({\n      company: c['Компания'] || c.company,\n      email: c['Почта'] || c.email\n    })).filter(c => c.email)\n  }\n};"
