        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"sonar-pro\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"ТВОЯ ЗАДАЧА – СГЕНЕРИРОВАТЬ ПОЛНЫЙ СПИСОК ВСЕХ ВОЗМОЖНЫХ ВАРИАЦИЙ ЗАПРОСОВ В ОПРЕДЕЛЁННОМ ФОРМАТЕ, УЛИЦ МОЖЕТ БЫТЬ ОТ 50 ДО 10000, МНЕ НУЖНЫ ВСЕ. ### ИНСТРУКЦИИ ### - ПОЛУЧАЕШЬ НАЗВАНИЕ ГОРОДА – СОБИРАЕШЬ ВСЕ УЛИЦЫ, ПРОСПЕКТЫ, ПЕРЕУЛКИ И ДРУГИЕ ТОПОНИМЫ ЭТОГО ГОРОДА. - ГЕНЕРИРУЕШЬ НЕ МЕНЕЕ 50 ДЛЯ КАЖДОЙ УЛИЦЫ ВАРИАЦИЮ ЗАПРОСА В ФОРМАТЕ: **\\\"город+тематика+название+улицы+проспекта\\\"** - ВОЗВРАЩАЕШЬ СТРОГО СПИСОК В ФОРМАТЕ **БЕЗ КОММЕНТАРИЕВ, БЕЗ ПРИВЕТСТВИЙ, БЕЗ ОБЪЯСНЕНИЙ**. - НЕ ДОБАВЛЯЕШЬ ЛИШНИХ СЛОВ, НЕ СПРАШИВАЕШЬ ДОПОЛНИТЕЛЬНЫХ ВОПРОСОВ. ### ФОРМАТ ВЫВОДА ### \\\"самара+стоматология+улица_ленина\\\",\\\"самара+стоматология+проспект+победы\\\",\\\"самара+стоматология+переулок+горького\\\",\\\"самара+стоматология+набережная+реки+волги\\\" ЧЕГО НЕ ДЕЛАТЬ НЕ СПРАШИВАТЬ ДОПОЛНИТЕЛЬНЫХ ВОПРОСОВ. НЕ ДОБАВЛЯТЬ ПРЕДИСЛОВИЯ, ПРИВЕТСТВИЯ И ОБЪЯСНЕНИЯ. НЕ ИЗМЕНЯТЬ ФОРМАТ ВЫВОДА. НЕ ПРОПУСКАТЬ НАЗВАНИЯ УЛИЦ, ПРОСПЕКТОВ И ДРУГИХ ТОПОНИМОВ ГОРОДА.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.query }}\"\n    }\n  ],\n  \"max_tokens\": 4000,\n  \"temperature\": 0.2,\n  \"top_p\": 0.9,\n  \"search_domain_filter\": [\n    \"perplexity.ai\"\n  ],\n  \"return_images\": false,\n  \"return_related_questions\": false,\n  \"search_recency_filter\": \"month\",\n  \"top_k\": 0,\n  \"stream\": false,\n  \"presence_penalty\": 0,\n  \"frequency_penalty\": 1\n}",
