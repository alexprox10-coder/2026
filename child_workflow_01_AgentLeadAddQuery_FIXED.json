              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "split-queries",
      "name": "📤 Split Queries",
      "type": "n8n-nodes-base.splitOut",
      "position": [
        680,
        300
      ],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://serpapi.com/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "engine",
              "value": "google"
            },
            {
              "name": "q",
              "value": "={{ $json.query }}"
            },
            {
              "name": "location",
              "value": "Russia"
            },
            {
              "name": "hl",
              "value": "ru"
            },
            {
              "name": "gl",
              "value": "ru"
            },
            {
              "name": "num",
              "value": "10"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "search-google",
      "name": "🔍 Google Search (SerpAPI)",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        900,
        300
      ],
      "typeVersion": 4.2,
      "credentials": {
        "httpQueryAuth": {
          "id": "YOUR_SERPAPI_CREDENTIAL_ID",
          "name": "SerpAPI"
        }
      },
      "notes": "Requires SerpAPI account - https://serpapi.com\nFree tier: 100 searches/month",
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const data = item.json;\n    \n    // Проверяем, есть ли результаты поиска\n    if (!data.organic_results || !Array.isArray(data.organic_results)) {\n      console.log('No organic results found');\n      continue;\n    }\n    \n    // Извлекаем сайты из результатов\n    for (const result of data.organic_results) {\n      const url = result.link || result.url;\n      const title = result.title || 'Unknown';\n      const snippet = result.snippet || '';\n      \n      if (!url) continue;\n      \n      // Фильтруем нерелевантные домены\n      const excludeDomains = [\n        'vk.com', 'facebook.com', 'instagram.com', 'youtube.com',\n        'avito.ru', '2gis.ru', 'yandex.ru', 'google.com',\n        'wikipedia.org', 'otzovik.com', 'irecommend.ru'\n      ];\n      \n      const hostname = new URL(url).hostname.replace('www.', '');\n      if (excludeDomains.some(domain => hostname.includes(domain))) {\n        continue;\n      }\n      \n      results.push({\n        json: {\n          url: url,\n          company_name: title,\n          description: snippet,\n          source: 'google_search',\n          search_query: data.search_parameters?.q || '',\n          found_at: new Date().toISOString(),\n          status: 0\n        }\n      });\n    }\n    \n  } catch (error) {\n    console.error(`Error processing search results: ${error.message}`);\n  }\n}\n\nconsole.log(`Found ${results.length} websites`);\nreturn results;"
      },
