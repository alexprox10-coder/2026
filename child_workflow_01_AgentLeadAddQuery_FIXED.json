      "id": "build-query-003",
      "name": "Построить поисковый запрос"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.perplexity.ai/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_PERPLEXITY_API_KEY_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"sonar-pro\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты поисковый ассистент. Твоя задача - найти компании по запросу и вернуть их данные в JSON формате.\\n\\nВЫХОДНОЙ ФОРМАТ (строго JSON, без комментариев):\\n{\\n  \\\"companies\\\": [\\n    {\\n      \\\"name\\\": \\\"Название компании\\\",\\n      \\\"website\\\": \\\"https://example.com\\\",\\n      \\\"city\\\": \\\"Город\\\",\\n      \\\"phone\\\": \\\"+7 XXX XXX-XX-XX\\\",\\n      \\\"email\\\": \\\"info@example.com\\\",\\n      \\\"description\\\": \\\"Краткое описание деятельности\\\"\\n    }\\n  ]\\n}\\n\\nТРЕБОВАНИЯ:\\n- Найди от 5 до 15 компаний\\n- Укажи РЕАЛЬНЫЕ контакты (телефон и email если найдешь)\\n- Укажи официальный сайт компании\\n- Если данных нет - оставь поле пустым\\n- НЕ добавляй пояснений, только JSON\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'Найди компании: ' + $json.search_query }}\"\n    }\n  ],\n  \"max_tokens\": 3000,\n  \"temperature\": 0.1,\n  \"top_p\": 0.9,\n  \"return_images\": false,\n  \"return_related_questions\": false,\n  \"search_recency_filter\": \"month\",\n  \"stream\": false\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        300
      ],
      "id": "perplexity-search-004",
      "name": "Perplexity - Поиск компаний",
      "notes": "ВАЖНО: Замените YOUR_PERPLEXITY_API_KEY_HERE на ваш реальный API ключ!\n\nАльтернативы если нет Perplexity:\n1. Claude API с WebSearch\n2. OpenAI GPT-4 с function calling\n3. Google Custom Search API"
    },
    {
      "parameters": {
        "jsCode": "// Извлекаем компании из ответа Perplexity\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    // Получаем контент из ответа\n    const content = item.json.choices[0].message.content;\n    \n    // Очищаем от markdown кода если есть\n    const cleanContent = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    \n    // Парсим JSON\n    let jsonData;\n    try {\n      jsonData = JSON.parse(cleanContent);\n    } catch (e) {\n      // Пытаемся извлечь JSON из текста\n      const jsonMatch = cleanContent.match(/\\{[\\s\\S]*\\}/);\n      if (jsonMatch) {\n        jsonData = JSON.parse(jsonMatch[0]);\n      } else {\n        console.log('Не удалось распарсить JSON:', cleanContent);\n        continue;\n      }\n    }\n    \n    // Извлекаем компании\n    if (jsonData.companies && Array.isArray(jsonData.companies)) {\n      for (const company of jsonData.companies) {\n        if (company.name) {\n          results.push({\n            json: {\n              company_name: company.name,\n              website: company.website || '',\n              city: company.city || $('Извлечь параметры').item.json.city || 'Не указан',\n              phone: company.phone || '',\n              email: company.email || '',\n              description: company.description || '',\n              source_query: $('Построить поисковый запрос').item.json.search_query,\n              found_date: new Date().toISOString(),\n              status: 'new'\n            }\n          });\n        }\n      }\n    }\n  } catch (error) {\n    console.error('Ошибка обработки:', error.message);\n  }\n}\n\nif (results.length === 0) {\n  console.log('Компании не найдены');\n  return [{ \n    json: { \n      error: 'Компании не найдены',\n      query: $('Построить поисковый запрос').item.json.search_query\n    } \n  }];\n}\n\nconsole.log(`Найдено компаний: ${results.length}`);\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1180,
        300
      ],
