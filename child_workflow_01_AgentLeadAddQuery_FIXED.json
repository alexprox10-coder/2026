{
  "name": "AgentLeadAddQuery",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "add-search-query",
        "options": {
          "rawBody": false
        },
        "responseMode": "responseNode"
      },
      "id": "webhook-add-query",
      "name": "📥 Webhook - Add Query",
      "type": "n8n-nodes-base.webhook",
      "position": [
        240,
        300
      ],
      "webhookId": "add-search-query-webhook",
      "typeVersion": 2
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const data = item.json.body || item.json;\n    \n    const query = String(data.query || '').trim();\n    const city = String(data.city || 'Благовещенск').trim();\n    const region = String(data.region || 'Амурская область').trim();\n    const industry = String(data.industry || 'недвижимость').trim();\n    \n    if (!query) {\n      results.push({\n        json: {\n          success: false,\n          error: 'Query is required',\n          code: 'MISSING_QUERY'\n        }\n      });\n      continue;\n    }\n    \n    // Формируем поисковые запросы\n    const searchQueries = [\n      `${query} ${city} ${region} сайт`,\n      `${industry} ${city} ${region} контакты`,\n      `${query} ${city} официальный сайт`,\n      `${industry} компании ${city}`\n    ];\n    \n    results.push({\n      json: {\n        original_query: query,\n        city: city,\n        region: region,\n        industry: industry,\n        search_queries: searchQueries,\n        created_at: new Date().toISOString(),\n        status: 'pending'\n      }\n    });\n    \n  } catch (error) {\n    results.push({\n      json: {\n        success: false,\n        error: `Processing error: ${error.message}`,\n        code: 'PROCESSING_ERROR'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "prepare-queries",
      "name": "📝 Подготовить запросы",
      "type": "n8n-nodes-base.code",
      "position": [
        460,
        300
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "query",
              "name": "query",
