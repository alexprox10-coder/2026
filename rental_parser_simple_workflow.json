      "parameters": {
        "language": "python",
        "pythonCode": "import subprocess\nimport json\nimport os\n\n# Путь к скрипту\nscript_path = '/home/user/2026/rental_parser/run_once.py'\n\n# Запуск скрипта\nresult = subprocess.run(\n    ['python3', script_path],\n    capture_output=True,\n    text=True,\n    cwd='/home/user/2026/rental_parser'\n)\n\n# Парсим вывод\nif result.returncode == 0:\n    # Ищем JSON в выводе\n    output_lines = result.stdout.strip().split('\\n')\n    json_started = False\n    json_lines = []\n    \n    for line in output_lines:\n        if line.strip() == '{':\n            json_started = True\n        if json_started:\n            json_lines.append(line)\n        if line.strip() == '}':\n            break\n    \n    if json_lines:\n        result_data = json.loads('\\n'.join(json_lines))\n    else:\n        result_data = {'success': True, 'output': result.stdout}\nelse:\n    result_data = {\n        'success': False,\n        'error': result.stderr,\n        'stdout': result.stdout\n    }\n\nreturn result_data"
      },
