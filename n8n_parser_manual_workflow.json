{
  "name": "Telegram Parser - Ручной запуск с формой",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Telegram Parser PRO",
        "formDescription": "Введите параметры для парсинга Telegram каналов",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Каналы (через запятую)",
              "fieldType": "text",
              "placeholder": "moscowach, channel2, channel3",
              "requiredField": true
            },
            {
              "fieldLabel": "Ключевые слова (через запятую)",
              "fieldType": "text",
              "placeholder": "ищу, куплю, нужен, требуется",
              "requiredField": true
            },
            {
              "fieldLabel": "Количество сообщений",
              "fieldType": "number",
              "placeholder": "100",
              "requiredField": false
            },
            {
              "fieldLabel": "Дней назад",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {"option": "1"},
                  {"option": "3"},
                  {"option": "7"},
                  {"option": "14"},
                  {"option": "30"}
                ]
              },
              "requiredField": false
            },
            {
              "fieldLabel": "Имя клиента (опционально)",
              "fieldType": "text",
              "placeholder": "Иван Иванов",
              "requiredField": false
            }
          ]
        },
        "options": {
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Парсинг запущен! Результаты будут отправлены в Telegram."
            }
          }
        }
      },
      "id": "form-trigger",
      "name": "Форма запроса",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "parser-form"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "channels",
              "name": "channels",
              "value": "={{ $json['Каналы (через запятую)'] }}",
              "type": "string"
            },
            {
              "id": "keywords",
              "name": "keywords",
              "value": "={{ $json['Ключевые слова (через запятую)'] }}",
              "type": "string"
            },
            {
              "id": "messages_limit",
              "name": "messages_limit",
              "value": "={{ $json['Количество сообщений'] || 100 }}",
              "type": "number"
            },
            {
              "id": "days_back",
              "name": "days_back",
              "value": "={{ $json['Дней назад'] || 7 }}",
              "type": "number"
            },
            {
              "id": "client_name",
              "name": "client_name",
              "value": "={{ $json['Имя клиента (опционально)'] || 'Неизвестный' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "prepare-params",
      "name": "Подготовка параметров",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://155.212.133.90:5000/webhook/n8n",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ channels: $json.channels || '', keywords: $json.keywords || '', messages_limit: Number($json.messages_limit) || 100, days_back: Number($json.days_back) || 7 }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "call-parser",
      "name": "Вызов Parser API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-result",
      "name": "Результат успешен?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "table_data",
        "options": {}
      },
      "id": "split-leads",
      "name": "Разбить лиды",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [1130, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "ВАШ_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Лиды",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "save-to-sheets",
      "name": "Сохранить в Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.2,
      "position": [1350, 200]
    },
    {
      "parameters": {
        "chatId": "ВАШ_TELEGRAM_CHAT_ID",
        "text": "=🎯 Парсинг для клиента: {{ $('Подготовка параметров').item.json.client_name }}\n\n📊 Результаты:\n━━━━━━━━━━━━━━━━\n📝 Всего сообщений: {{ $('Вызов Parser API').item.json.stats.total_messages }}\n✅ Релевантных: {{ $('Вызов Parser API').item.json.stats.matched_messages }}\n\n📞 Телефонов: {{ $('Вызов Parser API').item.json.stats.phones_found }}\n👤 Username: {{ $('Вызов Parser API').item.json.stats.usernames_found }}\n📧 Email: {{ $('Вызов Parser API').item.json.stats.emails_found }}\n\n🔥 Всего лидов: {{ $('Вызов Parser API').item.json.total_leads }}\n━━━━━━━━━━━━━━━━\n\nКаналы: {{ $('Подготовка параметров').item.json.channels }}\nКлючевые слова: {{ $('Подготовка параметров').item.json.keywords }}",
        "additionalFields": {}
      },
      "id": "send-telegram-success",
      "name": "Отправить в Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1350, 350]
    },
    {
      "parameters": {
        "chatId": "ВАШ_TELEGRAM_CHAT_ID",
        "text": "=❌ Ошибка парсинга!\n\nКлиент: {{ $('Подготовка параметров').item.json.client_name }}\nОшибка: {{ $json.error }}",
        "additionalFields": {}
      },
      "id": "send-telegram-error",
      "name": "Отправить ошибку",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1130, 450]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-phone",
              "leftValue": "={{ $json['Телефон'] }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "filter-with-contacts",
      "name": "Только с контактами",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [1570, 200]
    },
    {
      "parameters": {
        "chatId": "ВАШ_TELEGRAM_CHAT_ID",
        "text": "=🔥 ГОРЯЧИЙ ЛИД!\n\n📞 {{ $json['Телефон'] || 'Нет' }}\n👤 {{ $json['Username'] || 'Нет' }}\n📧 {{ $json['Email'] || 'Нет' }}\n\n📝 {{ $json['Текст'] }}\n\n🔗 {{ $json['Ссылка'] }}\n\n⭐ Скоринг: {{ $json['Скоринг'] }}/100",
        "additionalFields": {}
      },
      "id": "send-hot-leads",
      "name": "Отправить горячие лиды",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1790, 200]
    }
  ],
  "connections": {
