{
  "name": "Прогрев лидов недвижимости",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query", "message"],
        "additionalFields": {}
      },
      "id": "trigger",
      "name": "🤖 Бот",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 400],
      "webhookId": "realty-warmup",
      "credentials": {
        "telegramApi": { "id": "YOUR_TG_CRED_ID", "name": "Telegram Bot" }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst cb = input.callback_query;\nconst msg = input.message;\n\n// Если обычное сообщение (команда /start)\nif (!cb) {\n  const text = msg?.text || '';\n  const chatId = String(msg?.chat?.id || '');\n  const fromId = String(msg?.from?.id || '');\n  return [{\n    json: {\n      action: text === '/start' ? 'start' : 'unknown',\n      chatId,\n      cbId: '',\n      fromId,\n      leadId: '',\n      value: ''\n    }\n  }];\n}\n\n// Callback от кнопки\nconst data = cb.data || '';\nconst chatId = String(cb.message.chat.id);\nconst cbId = cb.id;\nconst fromId = String(cb.from.id);\n\nlet action = 'unknown';\nlet leadId = '';\nlet value = '';\n\n// Парсим callback_data\nif (data === 'start_warmup') {\n  action = 'start';\n} else if (data.startsWith('warm_')) {\n  action = 'send_first';\n  leadId = data.split('_')[1];\n} else if (data.startsWith('type_')) {\n  const parts = data.split('_');\n  action = 'ask_rooms';\n  value = parts[1];\n  leadId = parts[2] || '';\n} else if (data.startsWith('rooms_')) {\n  const parts = data.split('_');\n  action = 'ask_budget';\n  value = parts[1];\n  leadId = parts[2] || '';\n} else if (data.startsWith('budget_')) {\n  const parts = data.split('_');\n  action = 'ask_urgency';\n  value = parts[1];\n  leadId = parts[2] || '';\n} else if (data.startsWith('urgency_')) {\n  const parts = data.split('_');\n  action = 'offer_realtor';\n  value = parts[1];\n  leadId = parts[2] || '';\n} else if (data.startsWith('yes_realtor_')) {\n  action = 'send_realtor';\n  leadId = data.replace('yes_realtor_', '');\n} else if (data === 'skip' || data === 'next_lead') {\n  action = 'next_lead';\n} else if (data.startsWith('not_interested_')) {\n  action = 'mark_not_interested';\n  leadId = data.replace('not_interested_', '');\n}\n\nreturn [{ json: { action, chatId, cbId, fromId, leadId, value } }];"
      },
      "id": "parse",
      "name": "📋 Разбор",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.BOT_TOKEN }}/answerCallbackQuery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"callback_query_id\": \"{{ $json.cbId }}\"}",
        "options": {}
      },
      "id": "answer",
      "name": "✓",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 400],
      "continueOnFail": true
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "start", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 0 },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "send_first", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 1 },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "ask_rooms", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 2 },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "ask_budget", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 3 },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "ask_urgency", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 4 },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "offer_realtor", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 5 },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "send_realtor", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 6 },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "next_lead", "operator": { "type": "string", "operation": "equals" } }], "combinator": "and" }, "outputIndex": 0 }
          ]
        },
        "options": { "fallbackOutput": "none" }
      },
      "id": "router",
      "name": "🔀 Роутер",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [860, 400]
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "leads", "mode": "name" },
        "filtersUI": { "values": [{ "lookupColumn": "status", "lookupValue": "new" }] },
        "options": { "returnAllMatches": false }
      },
      "id": "get-new",
      "name": "📊 Новый лид",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1100, 100],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_SHEETS_CRED_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.lead_id }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }],
          "combinator": "and"
        }
      },
      "id": "has-lead",
      "name": "Есть лид?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1320, 100]
    },
    {
      "parameters": {
        "chatId": "={{ $('📋 Разбор').item.json.chatId }}",
        "text": "=📋 <b>Лид для прогрева:</b>\n\n{{ $json.text ? $json.text.substring(0, 400) : 'Текст отсутствует' }}\n\n👤 @{{ $json.username || 'нет username' }}\n📱 {{ $json.phone || 'телефон не найден' }}\n📍 {{ $json.channel || 'источник неизвестен' }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "reply_markup": {
            "inline_keyboard": [
              [{ "text": "🚀 Прогреть этого лида", "callback_data": "warm_{{ $json.lead_id }}" }],
              [{ "text": "⏭ Следующий", "callback_data": "next_lead" }]
            ]
          }
        }
      },
      "id": "show-lead",
      "name": "📱 Показать лида",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1540, 0],
      "credentials": { "telegramApi": { "id": "YOUR_TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "chatId": "={{ $('📋 Разбор').item.json.chatId }}",
        "text": "✅ Новых лидов нет. Все обработаны!",
        "additionalFields": {}
      },
      "id": "no-leads",
      "name": "📱 Нет лидов",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1540, 200],
      "credentials": { "telegramApi": { "id": "YOUR_TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "leads", "mode": "name" },
        "filtersUI": { "values": [{ "lookupColumn": "lead_id", "lookupValue": "={{ $('📋 Разбор').item.json.leadId }}" }] },
        "options": {}
      },
      "id": "get-lead",
      "name": "📊 Получить лида",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1100, 300],
      "credentials": { "googleSheetsOAuth2Api": { "id": "YOUR_SHEETS_CRED_ID", "name": "Google Sheets" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json.user_id }}\",\n  \"text\": \"Здравствуйте! 👋\\n\\nВидела ваше сообщение о недвижимости. Могу помочь с подбором!\\n\\n✅ Работаю напрямую с застройщиками и собственниками\\n✅ Без комиссии для покупателя\\n✅ Помогу с ипотекой под низкий %\\n\\nПодскажите, что именно ищете?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"🏢 Квартира в новостройке\", \"callback_data\": \"type_new_{{ $json.lead_id }}\"}],\n      [{\"text\": \"🏠 Вторичка\", \"callback_data\": \"type_secondary_{{ $json.lead_id }}\"}],\n      [{\"text\": \"🏡 Дом/Таунхаус\", \"callback_data\": \"type_house_{{ $json.lead_id }}\"}],\n      [{\"text\": \"❌ Не актуально\", \"callback_data\": \"not_interested_{{ $json.lead_id }}\"}]\n    ]\n  }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "first-msg",
      "name": "💬 Первое сообщение",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "YOUR_SHEET_ID", "mode": "id" },
        "sheetName": { "__rl": true, "value": "leads", "mode": "name" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "lead_id": "={{ $('📊 Получить лида').item.json.lead_id }}",
            "status": "contacted",
            "contacted_at": "={{ $now.toISO() }}"
          },
          "matchingColumns": ["lead_id"]
        },
        "options": {}
      },
      "id": "update-contacted",
      "name": "📝 Статус: contacted",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.4,
      "position": [1540, 300],
