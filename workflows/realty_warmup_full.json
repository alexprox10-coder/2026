            ]
          }
        }
      },
      "id": "confirm-sent",
      "name": "📱 Подтверждение",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1760, 300],
      "credentials": { "telegramApi": { "id": "YOUR_TG_CRED_ID", "name": "Telegram Bot" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('📋 Разбор').item.json.fromId }}\",\n  \"text\": \"Отлично! Сколько комнат вам нужно?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"Студия\", \"callback_data\": \"rooms_studio_{{ $('📋 Разбор').item.json.leadId }}\"}, {\"text\": \"1 комн\", \"callback_data\": \"rooms_1_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"2 комн\", \"callback_data\": \"rooms_2_{{ $('📋 Разбор').item.json.leadId }}\"}, {\"text\": \"3 комн\", \"callback_data\": \"rooms_3_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"4+ комн\", \"callback_data\": \"rooms_4plus_{{ $('📋 Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
      },
      "id": "ask-rooms",
      "name": "🚪 Комнаты",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('📋 Разбор').item.json.fromId }}\",\n  \"text\": \"Хорошо! Какой у вас бюджет?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"До 3 млн\", \"callback_data\": \"budget_3m_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"3-5 млн\", \"callback_data\": \"budget_3_5m_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"5-8 млн\", \"callback_data\": \"budget_5_8m_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"8-15 млн\", \"callback_data\": \"budget_8_15m_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"15+ млн\", \"callback_data\": \"budget_15m_plus_{{ $('📋 Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
      },
      "id": "ask-budget",
      "name": "💰 Бюджет",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 570]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('📋 Разбор').item.json.fromId }}\",\n  \"text\": \"Понял! Насколько срочно нужна недвижимость?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"🔥 Срочно (до 2 недель)\", \"callback_data\": \"urgency_urgent_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"📅 В течение месяца\", \"callback_data\": \"urgency_month_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"🗓 В течение 3 месяцев\", \"callback_data\": \"urgency_3months_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"🔍 Просто смотрю варианты\", \"callback_data\": \"urgency_looking_{{ $('📋 Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
      },
      "id": "ask-urgency",
      "name": "⏰ Срочность",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1100, 690]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('📋 Разбор').item.json.fromId }}\",\n  \"text\": \"Отлично! 🎯\\n\\nУ меня есть несколько подходящих вариантов для вас.\\n\\nМогу связать вас с риелтором, который:\\n✅ Покажет объекты лично\\n✅ Поможет с документами и ипотекой\\n✅ Без комиссии для вас\\n\\nСвязаться сейчас?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"✅ Да, свяжите меня\", \"callback_data\": \"yes_realtor_{{ $('📋 Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"📸 Сначала покажите варианты\", \"callback_data\": \"show_options_{{ $('📋 Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
