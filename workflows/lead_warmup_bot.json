        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $credentials.telegramApi.token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Разбор').item.json.fromId }}\",\n  \"text\": \"Когда планируете покупку?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"🔥 Срочно\", \"callback_data\": \"urgency_asap_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"📅 В течение месяца\", \"callback_data\": \"urgency_month_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"🗓 В течение 3 месяцев\", \"callback_data\": \"urgency_3months_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"🔍 Пока смотрю\", \"callback_data\": \"urgency_looking_{{ $('Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
      },
      "id": "ask-urgency",
      "name": "Спросить срочность",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 600],
      "credentials": { "telegramApi": { "id": "kkySYqFIPRx85OPe", "name": "Telegram ПАРСЕР" } }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $credentials.telegramApi.token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Разбор').item.json.fromId }}\",\n  \"text\": \"Отлично! У меня есть подходящие варианты 🏠\\n\\nКак удобнее связаться?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"📱 Позвоните мне\", \"callback_data\": \"contact_call_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"💬 Напишите в Telegram\", \"callback_data\": \"contact_tg_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"📧 На почту\", \"callback_data\": \"contact_email_{{ $('Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
      },
      "id": "ask-contact",
