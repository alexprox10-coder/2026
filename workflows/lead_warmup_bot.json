    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $credentials.telegramApi.token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Разбор').item.json.fromId }}\",\n  \"text\": \"Сколько комнат нужно?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"Студия\", \"callback_data\": \"rooms_studio_{{ $('Разбор').item.json.leadId }}\"}, {\"text\": \"1\", \"callback_data\": \"rooms_1_{{ $('Разбор').item.json.leadId }}\"}, {\"text\": \"2\", \"callback_data\": \"rooms_2_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"3\", \"callback_data\": \"rooms_3_{{ $('Разбор').item.json.leadId }}\"}, {\"text\": \"4+\", \"callback_data\": \"rooms_4_{{ $('Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
      },
