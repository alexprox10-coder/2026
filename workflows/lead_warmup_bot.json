        "url": "=https://api.telegram.org/bot{{ $credentials.telegramApi.token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $('Разбор').item.json.fromId }}\",\n  \"text\": \"Какой бюджет?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"До 3 млн\", \"callback_data\": \"budget_3m_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"3-5 млн\", \"callback_data\": \"budget_5m_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"5-10 млн\", \"callback_data\": \"budget_10m_{{ $('Разбор').item.json.leadId }}\"}],\n      [{\"text\": \"10+ млн\", \"callback_data\": \"budget_10plus_{{ $('Разбор').item.json.leadId }}\"}]\n    ]\n  }\n}",
        "options": {}
      },
      "id": "ask-budget",
      "name": "Спросить бюджет",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1260, 500],
      "credentials": { "telegramApi": { "id": "kkySYqFIPRx85OPe", "name": "Telegram ПАРСЕР" } }
    },
    {
