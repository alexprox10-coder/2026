{
  "name": "Бот прогрева лидов",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query", "message"],
        "additionalFields": {}
      },
      "id": "trigger",
      "name": "Telegram",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [200, 400],
      "webhookId": "lead-warmup-bot",
      "credentials": {
        "telegramApi": { "id": "kkySYqFIPRx85OPe", "name": "Telegram ПАРСЕР" }
      }
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst cb = input.callback_query;\nconst msg = input.message;\n\n// Обычное сообщение\nif (!cb) {\n  const text = (msg?.text || '').trim();\n  const chatId = String(msg?.chat?.id || '');\n  const fromId = String(msg?.from?.id || '');\n  const username = msg?.from?.username || '';\n  \n  // Команда /start от риелтора\n  if (text === '/start') {\n    return [{ json: { action: 'menu', chatId, fromId, username, cbId: '', leadId: '', value: '' } }];\n  }\n  \n  // Ответ от лида - ищем его в активных диалогах\n  return [{ json: { action: 'lead_reply', chatId, fromId, username, cbId: '', leadId: '', value: text } }];\n}\n\n// Callback от кнопки\nconst data = cb.data || '';\nconst chatId = String(cb.message?.chat?.id || '');\nconst cbId = cb.id;\nconst fromId = String(cb.from?.id || '');\nconst username = cb.from?.username || '';\n\nlet action = 'unknown';\nlet leadId = '';\nlet value = '';\n\n// Парсим callback_data\nif (data === 'start_warmup') {\n  action = 'start_warmup';\n} else if (data === 'show_stats') {\n  action = 'show_stats';\n} else if (data === 'menu') {\n  action = 'menu';\n} else if (data.startsWith('type_')) {\n  // type_apt_123 -> тип=apt, leadId=123\n  const parts = data.split('_');\n  action = 'set_type';\n  value = parts[1];\n  leadId = parts.slice(2).join('_');\n} else if (data.startsWith('rooms_')) {\n  const parts = data.split('_');\n  action = 'set_rooms';\n  value = parts[1];\n  leadId = parts.slice(2).join('_');\n} else if (data.startsWith('budget_')) {\n  const parts = data.split('_');\n  action = 'set_budget';\n  value = parts[1];\n  leadId = parts.slice(2).join('_');\n} else if (data.startsWith('urgency_')) {\n  const parts = data.split('_');\n  action = 'set_urgency';\n  value = parts[1];\n  leadId = parts.slice(2).join('_');\n} else if (data.startsWith('contact_')) {\n  const parts = data.split('_');\n  action = 'set_contact';\n  value = parts[1];\n  leadId = parts.slice(2).join('_');\n} else if (data.startsWith('refuse_')) {\n  action = 'refuse';\n  leadId = data.replace('refuse_', '');\n}\n\nreturn [{ json: { action, chatId, fromId, username, cbId, leadId, value } }];"
      },
      "id": "parse",
      "name": "Разбор",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 400]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.cbId }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }],
          "combinator": "and"
        }
      },
      "id": "check-cb",
      "name": "Callback?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [620, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $credentials.telegramApi.token }}/answerCallbackQuery",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"callback_query_id\": \"{{ $json.cbId }}\"}",
        "options": {}
      },
      "id": "answer-cb",
      "name": "Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [820, 350],
      "credentials": { "telegramApi": { "id": "kkySYqFIPRx85OPe", "name": "Telegram ПАРСЕР" } },
      "continueOnFail": true
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "menu", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "menu" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "start_warmup", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "warmup" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "show_stats", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "stats" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "set_type", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "type" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "set_rooms", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "rooms" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "set_budget", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "budget" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "set_urgency", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "urgency" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "set_contact", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "contact" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "refuse", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "refuse" },
            { "conditions": { "conditions": [{ "leftValue": "={{ $json.action }}", "rightValue": "lead_reply", "operator": { "type": "string", "operation": "equals" } }] }, "renameOutput": true, "outputLabel": "reply" }
          ]
        },
        "options": { "fallbackOutput": "none" }
      },
      "id": "router",
      "name": "Роутер",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1020, 400]
    },
    {
      "parameters": {
        "chatId": "={{ $('Разбор').item.json.chatId }}",
        "text": "🏠 <b>Бот прогрева лидов</b>\n\nЛиды собираются парсером из Telegram каналов.\nНажмите кнопку чтобы начать прогрев.",
        "additionalFields": {
          "parse_mode": "HTML",
          "reply_markup": {
            "inline_keyboard": [
              [{ "text": "🔥 Прогреть лиды", "callback_data": "start_warmup" }],
              [{ "text": "📊 Статистика", "callback_data": "show_stats" }]
            ]
          }
        }
      },
      "id": "menu",
      "name": "Меню",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1260, 100],
      "credentials": { "telegramApi": { "id": "kkySYqFIPRx85OPe", "name": "Telegram ПАРСЕР" } }
    },
    {
      "parameters": {
        "operation": "read",
        "documentId": { "__rl": true, "value": "1alr08qWL2TTVF-1nuDeU4NVXoGgyODgLKeTsa16_kxE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "gid=1925947783", "mode": "id" },
        "filtersUI": { "values": [{ "lookupColumn": "status", "lookupValue": "new" }] },
        "options": { "returnAllMatches": true }
      },
      "id": "get-leads",
      "name": "Лиды из таблицы",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1260, 250],
      "credentials": { "googleSheetsOAuth2Api": { "id": "3tw79kiICQ7OPZI8", "name": "Google Sheets ТЕЛЕГРАМ ПАРС" } }
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all();\nconst realtorChatId = $('Разбор').first().json.chatId;\n\n// Фильтруем лидов у которых есть username или user_id для связи\nconst contactable = leads.filter(item => {\n  const lead = item.json;\n  return (lead.usernames && lead.usernames.trim()) || \n         (lead.user_id && lead.user_id.trim()) ||\n         (lead.chat_id && lead.chat_id.trim());\n});\n\nif (contactable.length === 0) {\n  return [{ json: { hasLeads: false, realtorChatId, message: 'Нет лидов с контактами для прогрева' } }];\n}\n\n// Берём первых 10 для прогрева\nconst toWarm = contactable.slice(0, 10);\n\nreturn [{ \n  json: { \n    hasLeads: true, \n    realtorChatId,\n    count: toWarm.length,\n    leads: toWarm.map(l => l.json)\n  } \n}];"
      },
      "id": "filter-leads",
      "name": "Фильтр лидов",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1480, 250]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.hasLeads }}", "rightValue": true, "operator": { "type": "boolean", "operation": "equals" } }],
          "combinator": "and"
        }
      },
      "id": "has-leads",
      "name": "Есть лиды?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1700, 250]
    },
    {
      "parameters": {
        "chatId": "={{ $json.realtorChatId }}",
        "text": "❌ Нет лидов для прогрева.\n\nВсе лиды либо уже обработаны, либо не имеют контактов (username/user_id).",
        "additionalFields": {
          "reply_markup": {
            "inline_keyboard": [[{ "text": "🔙 Меню", "callback_data": "menu" }]]
          }
        }
      },
      "id": "no-leads",
      "name": "Нет лидов",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1920, 350],
      "credentials": { "telegramApi": { "id": "kkySYqFIPRx85OPe", "name": "Telegram ПАРСЕР" } }
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst leads = data.leads;\nconst results = [];\n\nfor (const lead of leads) {\n  // Определяем куда писать\n  let targetChatId = lead.chat_id || lead.user_id || '';\n  let targetUsername = '';\n  \n  // Если нет chat_id, пробуем username\n  if (!targetChatId && lead.usernames) {\n    const usernames = lead.usernames.split(',').map(u => u.trim().replace('@', ''));\n    if (usernames.length > 0 && usernames[0]) {\n      targetUsername = usernames[0];\n    }\n  }\n  \n  // Создаём уникальный ID лида\n  const leadId = lead.row_number || lead.post_url?.split('/').pop() || Date.now().toString();\n  \n  results.push({\n    json: {\n      leadId,\n      targetChatId,\n      targetUsername,\n      text: lead.text || '',\n      textPreview: (lead.text_preview || lead.text || '').substring(0, 100),\n      channel: lead.channel_title || '',\n      niche: lead.niche || '',\n      phones: lead.phones || '',\n      realtorChatId: data.realtorChatId\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "prepare-messages",
      "name": "Подготовить сообщения",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 150]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop",
      "name": "По одному",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [2140, 150]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [{ "leftValue": "={{ $json.targetChatId }}", "rightValue": "", "operator": { "type": "string", "operation": "notEmpty" } }],
          "combinator": "and"
        }
      },
      "id": "has-chat-id",
      "name": "Есть chat_id?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [2360, 150]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $credentials.telegramApi.token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"{{ $json.targetChatId }}\",\n  \"text\": \"Здравствуйте! 👋\\n\\nВидела ваше сообщение о недвижимости. Могу помочь с подбором!\\n\\n✅ Работаю напрямую с застройщиками\\n✅ Без комиссии для покупателя\\n✅ Помогу с ипотекой\\n\\nЧто именно ищете?\",\n  \"reply_markup\": {\n    \"inline_keyboard\": [\n      [{\"text\": \"🏢 Квартиру\", \"callback_data\": \"type_apt_{{ $json.leadId }}\"}],\n      [{\"text\": \"🏠 Дом\", \"callback_data\": \"type_house_{{ $json.leadId }}\"}],\n      [{\"text\": \"🏬 Коммерцию\", \"callback_data\": \"type_commercial_{{ $json.leadId }}\"}],\n      [{\"text\": \"❌ Не актуально\", \"callback_data\": \"refuse_{{ $json.leadId }}\"}]\n    ]\n  }\n}",
        "options": { "timeout": 10000 }
      },
      "id": "send-first",
      "name": "Первое сообщение",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2580, 50],
      "credentials": { "telegramApi": { "id": "kkySYqFIPRx85OPe", "name": "Telegram ПАРСЕР" } },
      "continueOnFail": true
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "value": "1alr08qWL2TTVF-1nuDeU4NVXoGgyODgLKeTsa16_kxE", "mode": "id" },
        "sheetName": { "__rl": true, "value": "gid=1925947783", "mode": "id" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "status": "contacted",
