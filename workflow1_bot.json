      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst chatId = item.chatId;\nconst payload = item.payload || {};\nconst staticData = $getWorkflowStaticData('global');\nconst userState = staticData.users && staticData.users[chatId] ? staticData.users[chatId] : {};\nconst daysBack = payload.days_back || parseInt(userState.days_back || '7');\nconst keywords = payload.keywords || userState.keywords || [];\nif (staticData.users && staticData.users[chatId]) {\n  staticData.users[chatId].state = 'idle';\n  staticData.users[chatId].days_back = null;\n  staticData.users[chatId].keywords = null;\n}\nreturn [{ json: { chatId, days_back: daysBack, keywords } }];"
      },
