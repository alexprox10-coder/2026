    {
      "parameters": {
        "method": "POST",
        "url": "https://n8n.arendadom24.ru/webhook/smart-lead-trigger",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n    \"chat_id\": \"{{ $json.chatId }}\",\n    \"niche\": \"{{ $json.payload.replace('niche : ', '') }}\"\n}\n",
        "options": {}
      },
      "id": "32e0befe-2955-4cfc-82b1-483efc1b7b38",
      "name": "Триггер отправки лидам (WF3)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        512
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst message = item.message;\nif (!message) return [{ json: { action: 'ignore', chatId: null } }];\nconst chatId = String(message.chat.id);\nconst text = (message.text || '').trim();\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.users) staticData.users = {};\nif (!staticData.users[chatId]) staticData.users[chatId] = { state: 'idle' };\nconst userState = staticData.users[chatId];\nconst currentState = userState.state || 'idle';\nlet action = 'unknown';\nlet payload = {};\n\nif (text === '/start') {\n  action = 'start';\n  staticData.users[chatId].state = 'waiting_niche';\n} else if (text === '/leads') {\n  action = 'leads_status';\n} else if (text === '/status') {\n  action = 'bot_status';\n} else if (text === '/niches') {\n  action = 'list_niches';\n} else if (currentState === 'waiting_niche') {\n  action = 'niche_input';\n  payload.niche = text;\n  staticData.users[chatId].state = 'waiting_confirm';\n  staticData.users[chatId].current_niche = text;\n} else if (currentState === 'waiting_confirm') {\n  staticData.users[chatId].state = 'idle';\n  if (text.toLowerCase() === 'да' || text.toLowerCase() === 'yes') {\n    action = 'confirm_save';\n    payload.niche = staticData.users[chatId].current_niche;\n  } else {\n    action = 'cancel_save';\n  }\n} else if (currentState === 'waiting_keywords') {\n  payload.keywords = text === '/skip' ? [] : text.split(',').map(k => k.trim()).filter(k => k.length > 0);\n  staticData.users[chatId].keywords = payload.keywords;\n  staticData.users[chatId].state = 'idle';\n  action = 'trigger_parse';\n  payload.days_back = parseInt(staticData.users[chatId].days_back || '7');\n  staticData.users[chatId].days_back = null;\n} else {\n  action = 'default_reply';\n}\n\nreturn [{ json: { action, chatId, text, payload, currentState } }];\n"
      },
