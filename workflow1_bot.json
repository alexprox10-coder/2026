      "parameters": {
        "jsCode": "const searchResult = $input.first().json;\nconst channels = searchResult.channels || [];\nconst chatId = $('Подготовить нишу').first().json.chatId;\nconst niche = $('Подготовить нишу').first().json.niche;\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.users) staticData.users = {};\nif (!staticData.users[chatId]) staticData.users[chatId] = {};\nstaticData.users[chatId].found_channels = channels;\nstaticData.users[chatId].current_niche = niche;\nreturn [{ json: { chatId, niche, channels, count: channels.length } }];"
      },
