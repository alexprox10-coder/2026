    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const html = item.json;\n    const metadata = item.json;\n    \n    // Очистка HTML от скриптов и стилей\n    let cleanText = String(html)\n      .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n      .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n      .replace(/<[^>]+>/g, ' ')\n      .replace(/&nbsp;/g, ' ')\n      .replace(/&quot;/g, '\"')\n      .replace(/&amp;/g, '&')\n      .replace(/&[a-z]+;/gi, ' ')\n      .replace(/\\s+/g, ' ')\n      .trim();\n    \n    // Ограничение текста для AI (первые 15000 символов)\n    cleanText = cleanText.substring(0, 15000);\n    \n    results.push({\n      json: {\n        site_id: metadata.ID,\n        url: metadata.URL,\n        company_name: metadata['Company Name'],\n        html_text: cleanText,\n        fetch_time: new Date().toISOString()\n      }\n    });\n    \n  } catch (error) {\n    console.error(`Ошибка обработки HTML: ${error.message}`);\n  }\n}\n\nreturn results;"
      },
      "id": "clean-html",
      "name": "🧹 Очистить HTML",
      "type": "n8n-nodes-base.code",
      "position": [
        1780,
        200
      ],
      "typeVersion": 2
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Проанализируй текст сайта компании и извлеки следующую информацию:\\n\\n' + $json.html_text + '\\n\\nИзвлеки данные:\\n- company_name: Название компании\\n- inn: ИНН (если есть)\\n- address: Адрес\\n- phone: Телефон(ы)\\n- email: Email\\n- description: Краткое описание деятельности (2-3 предложения)\\n- products_services: Основные товары/услуги (список)\\n- contact_person: Контактное лицо (если указано)\\n\\nВерни ТОЛЬКО валидный JSON без markdown блоков.\\n\\nЕсли какая-то информация не найдена, используй пустую строку \"\" для строковых полей.' }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "Ты эксперт по извлечению информации о компаниях с их веб-сайтов.\n\nТвоя задача:\n1. Проанализировать текст сайта компании\n2. Найти и извлечь ключевую информацию\n3. Вернуть структурированный JSON\n\nТребования:\n- Все тексты на русском языке\n- Если данные не найдены - возвращай пустые строки\n- Номера телефонов в формате +7 (XXX) XXX-XX-XX\n- Email в валидном формате\n- description должно быть кратким и информативным\n- products_services - список через запятую"
        }
      },
