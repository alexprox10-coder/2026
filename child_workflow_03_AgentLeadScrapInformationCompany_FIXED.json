      "parameters": {
        "jsCode": "// Ограничение: обрабатываем максимум 20 сайтов за раз\nconst items = $input.all().slice(0, 20);\n\nconsole.log(`🔄 Обработка ${items.length} сайтов`);\n\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    processing_started: new Date().toISOString()\n  }\n}));"
