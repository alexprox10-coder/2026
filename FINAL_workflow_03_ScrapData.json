      "id": "get-sites",
      "name": "Получить сайты (статус=0)",
      "type": "n8n-nodes-base.googleSheets",
      "position": [460, 400],
      "typeVersion": 4.7,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_CREDENTIAL_ID",
