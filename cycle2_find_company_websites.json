        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"sonar-pro\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Ты поисковый ассистент. Твоя задача - найти официальные сайты компаний по поисковому запросу. Верни результат СТРОГО в JSON формате без дополнительных комментариев:\\n{\\n  \\\"companies\\\": [\\n    {\\n      \\\"name\\\": \\\"Название компании\\\",\\n      \\\"website\\\": \\\"https://example.com\\\",\\n      \\\"city\\\": \\\"Город\\\"\\n    }\\n  ]\\n}\\nНайди от 3 до 10 компаний. Если не можешь найти - верни пустой массив. НЕ добавляй пояснений, только JSON.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"={{ 'Найди официальные сайты компаний по запросу: ' + $json['Запросы'] }}\"\n    }\n  ],\n  \"max_tokens\": 2000,\n  \"temperature\": 0.1,\n  \"top_p\": 0.9,\n  \"return_images\": false,\n  \"return_related_questions\": false,\n  \"search_recency_filter\": \"month\",\n  \"stream\": false\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "id": "perplexity-search",
      "name": "Perplexity - Поиск сайтов"
    },
    {
      "parameters": {
        "jsCode": "// Parse Perplexity response and extract companies\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    // Get response content\n    const content = item.json.choices[0].message.content;\n    \n    // Try to parse JSON from response\n    let jsonData;\n    \n    // Remove markdown code blocks if present\n    const cleanContent = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n    \n    try {\n      jsonData = JSON.parse(cleanContent);\n    } catch (e) {\n      // Try to extract JSON from text\n      const jsonMatch = cleanContent.match(/\\{[\\s\\S]*\\}/);\n      if (jsonMatch) {\n        jsonData = JSON.parse(jsonMatch[0]);\n      } else {\n        console.log('Could not parse JSON from response:', cleanContent);\n        continue;\n      }\n    }\n    \n    // Extract companies\n    if (jsonData.companies && Array.isArray(jsonData.companies)) {\n      for (const company of jsonData.companies) {\n        if (company.website && company.name) {\n          results.push({\n            json: {\n              company_name: company.name,\n              website: company.website,\n              city: company.city || 'Не указан',\n              source_query: item.json.query || 'Unknown',\n              found_date: new Date().toISOString(),\n              status: 'new'\n            }\n          });\n        }\n      }\n    }\n  } catch (error) {\n    console.error('Error processing item:', error.message);\n  }\n}\n\nif (results.length === 0) {\n  console.log('No companies found');\n  return [{ json: { error: 'No companies found' } }];\n}\n\nconsole.log(`Found ${results.length} companies`);\nreturn results;"
      },
