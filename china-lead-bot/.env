# ==========================================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# ==========================================

# 1. TELEGRAM BOT TOKEN (ОБЯЗАТЕЛЬНО!)
# Как получить:
# 1. Откройте @BotFather в Telegram
# 2. Отправьте /newbot
# 3. Следуйте инструкциям
# 4. Скопируйте токен сюда
TELEGRAM_BOT_TOKEN=ЗАМЕНИТЕ_ЭТОТ_ТЕКСТ_НА_ВАШ_ТОКЕН_ОТ_BOTFATHER

# 2. N8N WEBHOOK URL (ОБЯЗАТЕЛЬНО!)
# Как получить:
# 1. Откройте n8n workflow "ChinaLeadBot v3"
# 2. АКТИВИРУЙТЕ workflow (переключатель Active)
# 3. Кликните узел "Webhook Trigger"
# 4. Скопируйте "Production URL"
# Пример: https://app.n8n.cloud/webhook/chinaleadbot-search
N8N_WEBHOOK_URL=ЗАМЕНИТЕ_НА_ВАШ_WEBHOOK_URL_ИЗ_N8N

# ==========================================
# ОПЦИОНАЛЬНЫЕ НАСТРОЙКИ
# ==========================================

# 3. ANTHROPIC CLAUDE API (Опционально - используется только для улучшения запросов)
# Бот работает БЕЗ этого ключа!
# Основная AI работа делается через n8n + OpenAI
# Если оставите пустым - запросы будут отправляться напрямую без предобработки
ANTHROPIC_API_KEY=

# 4. GOOGLE SHEETS (Опционально - если уже настроено в n8n)
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/ВАШ_ID/edit
GOOGLE_SHEET_ID=

# ==========================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ (не обязательно менять)
# ==========================================

# Payment Systems (для будущей интеграции платежей)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Database
DATABASE_URL=sqlite:///china_lead_bot.db

# Bot Settings
ADMIN_USER_IDS=
DEFAULT_LANGUAGE=ru
MAX_FREE_LEADS=5

# Subscription Plans (monthly prices in RUB)
PLAN_BASIC_PRICE=2990
PLAN_BASIC_LEADS=50
PLAN_PRO_PRICE=7990
PLAN_PRO_LEADS=200
PLAN_ENTERPRISE_PRICE=19990
PLAN_ENTERPRISE_LEADS=999999

# Lead Pricing (additional leads)
PRICE_QUALIFIED_LEAD=200
PRICE_WARM_LEAD=500
PRICE_MEETING_SCHEDULED=2000

# Scraping Settings
ALIBABA_DELAY=2
MAX_RESULTS_PER_SEARCH=100
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ==========================================
# ВАЖНО! После заполнения TELEGRAM_BOT_TOKEN и N8N_WEBHOOK_URL:
# 1. Сохраните файл
# 2. Запустите: python check_config.py
# 3. Если всё ОК - запустите: python bot/main.py
# ==========================================
