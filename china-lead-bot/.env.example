# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# n8n Configuration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-search
N8N_API_KEY=your_n8n_api_key_here

# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_FILE=config/google_credentials.json

# Payment Systems
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_SECRET_KEY=your_secret_key_here

# Database
DATABASE_URL=sqlite:///china_lead_bot.db

# Bot Settings
ADMIN_USER_IDS=123456789,987654321
DEFAULT_LANGUAGE=ru
MAX_FREE_LEADS=5

# Subscription Plans (monthly prices in RUB)
PLAN_BASIC_PRICE=2990
PLAN_BASIC_LEADS=50
PLAN_PRO_PRICE=7990
PLAN_PRO_LEADS=200
PLAN_ENTERPRISE_PRICE=19990
PLAN_ENTERPRISE_LEADS=999999

# Lead Pricing (additional leads)
PRICE_QUALIFIED_LEAD=200
PRICE_WARM_LEAD=500
PRICE_MEETING_SCHEDULED=2000

# Scraping Settings
ALIBABA_DELAY=2
MAX_RESULTS_PER_SEARCH=100
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
