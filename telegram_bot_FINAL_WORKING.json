          "replyMarkup": "inlineKeyboard",
          "inlineKeyboard": "={{ \n{\n  \"inline_keyboard\": [\n    [\n      {\"text\": \"🟢 Парсить Avito\", \"callback_data\": \"parse_avito\"}\n    ],\n    [\n      {\"text\": \"🔵 Парсить ЦИАН\", \"callback_data\": \"parse_cian\"}\n    ],\n    [\n      {\"text\": \"🟣 Парсить оба\", \"callback_data\": \"parse_both\"}\n    ],\n    [\n      {\"text\": \"⏰ Настройки\", \"callback_data\": \"settings\"}\n    ],\n    [\n      {\"text\": \"▶️ Включить\", \"callback_data\": \"enable\"},\n      {\"text\": \"⏸️ Выключить\", \"callback_data\": \"disable\"}\n    ],\n    [\n      {\"text\": \"❓ Помощь\", \"callback_data\": \"help\"}\n    ]\n  ]\n}\n}}"
        }
