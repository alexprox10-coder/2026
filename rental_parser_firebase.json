      "id": "get_unsent",
      "name": "Get Unsent (Firebase)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const data = JSON.parse($input.first().json.stdout);\n\nif (!data || data.length === 0) {\n  return [];\n}\n\nreturn data.map(item => ({ json: item }));"
      },
      "id": "parse_json",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "jsCode": "const platform = $json.platform || 'unknown';\nconst platformEmoji = {\n  'cian': '🔵',\n  'yandex': '🔴',\n  'avito': '🟢'\n}[platform] || '⚪';\n\nconst platformName = {\n  'cian': 'Cian.ru',\n  'yandex': 'Yandex.Realty',\n  'avito': 'Avito.ru'\n}[platform] || platform;\n\nconst roomsText = $json.rooms === 0 ? 'Студия' : \n                  $json.rooms ? `${$json.rooms}-комн` : '';\n\nconst priceText = $json.price ? \n                  `${Math.round($json.price).toLocaleString('ru-RU')} ₽/мес` : \n                  'Цена не указана';\n\nlet message = `${platformEmoji} *Новое объявление - ${platformName}*\\n\\n`;\nmessage += `*${$json.title}*\\n\\n`;\nmessage += `💰 ${priceText}\\n`;\n\nif (roomsText) {\n  message += `🏠 ${roomsText}`;\n}\n\nif ($json.area) {\n  message += `${roomsText ? ', ' : '📐 '}${$json.area} м²`;\n}\n\nmessage += '\\n';\n\nif ($json.address) {\n  message += `📍 ${$json.address}\\n`;\n}\n\nif ($json.phone) {\n  message += `📞 \\`${$json.phone}\\`\\n`;\n} else {\n  message += `📞 Телефон не указан\\n`;\n}\n\nmessage += `\\n🔗 [Открыть объявление](${$json.url})\\n`;\nmessage += `\\n_Площадка: ${platformName}_`;\nmessage += `\\n☁️ _Firebase Cloud_`;\n\nreturn {\n  json: {\n    ...$json,\n    message: message,\n    platform_emoji: platformEmoji\n  }\n};"
      },
      "id": "format_message",
      "name": "Format Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "telegramApi",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "={{ $json.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send_telegram",
      "name": "Send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
