    {
      "parameters": {
        "jsCode": "// Обрабатываем результаты Авито - ИСПРАВЛЕННАЯ ВЕРСИЯ v2\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data || !data.url) continue;\n  \n  // Извлекаем цену - проверяем разные форматы\n  let price = 'Цена не указана';\n  if (data.price) {\n    if (typeof data.price === 'string') {\n      // Извлекаем только цифры\n      const nums = data.price.match(/\\d+/g);\n      if (nums) {\n        price = nums.join('');\n      } else {\n        price = data.price;\n      }\n    } else if (typeof data.price === 'number') {\n      price = data.price.toString();\n    } else if (typeof data.price === 'object') {\n      price = data.price.value || data.price.amount || data.price.rub || data.price.text || JSON.stringify(data.price);\n    }\n  } else if (data.priceNum) {\n    price = data.priceNum.toString();\n  } else if (data.priceValue) {\n    price = data.priceValue.toString();\n  } else if (data.priceText) {\n    const nums = data.priceText.match(/\\d+/g);\n    if (nums) price = nums.join('');\n  }\n  \n  // Извлекаем адрес - проверяем ВСЕ возможные поля\n  let address = '';\n  \n  // Прямые поля адреса\n  if (data.address && typeof data.address === 'string' && data.address.length > 3) {\n    address = data.address;\n  } else if (data.location && typeof data.location === 'string' && data.location.length > 3) {\n    address = data.location;\n  } else if (data.locationText && typeof data.locationText === 'string') {\n    address = data.locationText;\n  } else if (data.addressText && typeof data.addressText === 'string') {\n    address = data.addressText;\n  }\n  \n  // Проверяем вложенные объекты geo/location\n  if (!address && data.geo) {\n    if (data.geo.address) address = data.geo.address;\n    else if (data.geo.formattedAddress) address = data.geo.formattedAddress;\n    else if (data.geo.street) address = data.geo.street;\n    else if (data.geo.location) address = data.geo.location;\n  }\n  \n  if (!address && data.location && typeof data.location === 'object') {\n    if (data.location.address) address = data.location.address;\n    else if (data.location.street) address = data.location.street;\n    else if (data.location.text) address = data.location.text;\n  }\n  \n  // Пробуем извлечь из title\n  if (!address && data.title) {\n    // Ищем паттерны адреса в заголовке: \"ул.\", \"пр.\", \"ш.\", \"пер.\"\n    const titleMatch = data.title.match(/(?:ул\\.|улица|пр\\.|проспект|ш\\.|шоссе|пер\\.|переулок|б-р|бульвар|наб\\.|набережная)[^,]*/i);\n    if (titleMatch) {\n      address = titleMatch[0].trim();\n    }\n  }\n  \n  // Пробуем извлечь из description\n  if (!address && data.description) {\n    const descMatch = data.description.match(/(?:адрес|находится|расположен)[:\\s]*([^,.]+)/i);\n    if (descMatch) {\n      address = descMatch[1].trim();\n    }\n  }\n  \n  // Если всё ещё нет адреса\n  if (!address) {\n    address = 'Адрес не указан';\n  }\n  \n  // Извлекаем заголовок\n  let title = data.title || data.name || 'Квартира';\n  \n  results.push({\n    json: {\n      id: data.url,\n      title: title,\n      price: price,\n      address: address,\n      url: data.url,\n      source: 'Авито',\n      city: 'Благовещенск',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [];"
      },
      "id": "1d9a6c6a-6449-403d-938d-9e9f649e982f",
      "name": "Обработка Авито",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2032,
