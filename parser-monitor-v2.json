    {
      "parameters": {
        "jsCode": "// Обрабатываем результаты ЦИАН\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  if (!data) continue;\n  \n  // ЦИАН: получаем URL\n  const cianId = data.cianId || data.id;\n  const url = data.siteUrl || data.url || (cianId ? `https://www.cian.ru/rent/flat/${cianId}/` : null);\n  \n  if (!url) continue;\n  \n  // Получаем адрес\n  const address = data.formattedAddress || data.address || data.geo?.address || data.geo?.formattedAddress || 'Адрес не указан';\n  \n  // Получаем цену\n  let price = 'Цена не указана';\n  if (data.formattedFullPrice) {\n    price = data.formattedFullPrice;\n  } else if (data.price) {\n    price = typeof data.price === 'number' ? data.price.toString() : data.price;\n  } else if (data.priceValue) {\n    price = data.priceValue.toString();\n  } else if (data.bargainTerms?.price) {\n    price = data.bargainTerms.price.toString();\n  }\n  \n  results.push({\n    json: {\n      id: url,\n      title: data.title || 'Квартира',\n      price: price,\n      address: address,\n      url: url,\n      source: 'ЦИАН',\n      city: 'Благовещенск',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "ac217b53-32db-4ca4-9c52-3b8f48e8be51",
      "name": "Обработка ЦИАН",
      "type": "n8n-nodes-base.code",
