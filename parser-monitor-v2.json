    {
      "parameters": {
        "jsCode": "// Фильтруем данные и убираем пустые\nconst items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  \n  // Пропускаем если нет URL\n  if (!data || !data.url) continue;\n  \n  results.push({\n    json: {\n      id: data.id || data.url,\n      title: data.title || 'Объявление',\n      price: data.price || 'Цена не указана',\n      address: data.address || 'Адрес не указан',\n      url: data.url,\n      source: data.source || 'Неизвестно',\n      city: data.city || 'Благовещенск',\n      timestamp: data.timestamp || new Date().toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
