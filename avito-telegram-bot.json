    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/acts/D81KRIfXBnQ4hg8Bz/runs?token=YOUR_APIFY_TOKEN&waitForFinish=600",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"startUrls\": [\n    {\n      \"url\": \"https://www.avito.ru/amurskaya_oblast_blagoveschensk/kvartiry/sdam/na_dlitelnyy_srok-ASgBAgICAkSSA8gQ8AeQUg\"\n    }\n  ],\n  \"limit\": 20,\n  \"proxyConfiguration\": {\n    \"useApifyProxy\": true,\n    \"apifyProxyGroups\": [\"RESIDENTIAL\"]\n  }\n}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 600000
        }
      },
      "id": "run-avito",
      "name": "Запуск Авито парсера",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1050, 350]
    },
    {
      "parameters": {
        "url": "={{ 'https://api.apify.com/v2/datasets/' + $json.data.defaultDatasetId + '/items?token=YOUR_APIFY_TOKEN' }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "get-results",
      "name": "Получить результаты",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1250, 350]
    },
    {
      "parameters": {
        "jsCode": "const firstItem = $input.first();\nconst body = firstItem.json.body;\nconst results = [];\n\nif (!body || (Array.isArray(body) && body.length === 0)) {\n  return [{ json: { empty: true } }];\n}\n\nconst dataArray = Array.isArray(body) ? body : [body];\n\nfor (const listing of dataArray) {\n  if (!listing || typeof listing !== 'object') continue;\n  \n  const url = listing.sourceLink || listing.url || listing.link;\n  if (!url) continue;\n  \n  let price = '';\n  if (listing.priceText) {\n    price = listing.priceText;\n  } else if (listing.price) {\n    price = String(listing.price) + ' ₽';\n  }\n  \n  let address = listing.location || listing.address || 'Благовещенск';\n  \n  results.push({\n    json: {\n      id: url,\n      title: listing.title || 'Квартира',\n      price: price,\n      address: address,\n      url: url,\n      source: 'Авито',\n      timestamp: new Date().toISOString()\n    }\n  });\n}\n\nreturn results.length > 0 ? results : [{ json: { empty: true } }];"
      },
      "id": "process-avito",
      "name": "Обработка данных",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 350]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "has-url",
              "leftValue": "={{ $json.url }}",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "filter-valid",
      "name": "Есть URL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1650, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot7906817029:AAHlqi5MKQ0pNlAcTPLpUP0np_xfC3zWxSM/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"chat_id\": \"7984101063\",\n  \"text\": \"🏠 Новое предложение!\\n\\n📍 {{ $json.address }}\\n💰 {{ $json.price }}\\n🔗 Открыть объявление\\n\\nИсточник: Авито\\n\\n{{ $json.url }}\",\n  \"link_preview_options\": {\n    \"is_disabled\": false,\n    \"prefer_large_media\": true,\n    \"show_above_text\": false\n  }\n}",
        "options": {}
      },
