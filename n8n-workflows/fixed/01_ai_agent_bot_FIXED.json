    {
      "parameters": {
        "jsCode": "// State machine: разбираем входящее сообщение\nconst item = $input.first().json;\nconst message = item.message;\n\nif (!message) {\n  return [{ json: { action: 'ignore', chatId: null } }];\n}\n\nconst chatId = String(message.chat.id);\nconst text = (message.text || '').trim();\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.users) staticData.users = {};\nif (!staticData.users[chatId]) {\n  staticData.users[chatId] = { state: 'idle' };\n}\n\nconst userState = staticData.users[chatId];\nconst currentState = userState.state || 'idle';\n\nlet action = 'unknown';\nlet payload = {};\n\nif (text === '/start') {\n  action = 'start';\n  staticData.users[chatId].state = 'waiting_niche';\n} else if (text === '/leads') {\n  action = 'leads_status';\n} else if (text === '/status') {\n  action = 'bot_status';\n} else if (text === '/niches') {\n  action = 'list_niches';\n} else if (currentState === 'waiting_niche') {\n  action = 'niche_input';\n  payload.niche = text;\n  staticData.users[chatId].state = 'idle';\n  staticData.users[chatId].current_niche = text;\n} else if (currentState === 'waiting_keywords') {\n  if (text === '/skip') {\n    action = 'keywords_skip';\n    payload.keywords = [];\n  } else {\n    action = 'keywords_input';\n    payload.keywords = text.split(',').map(k => k.trim()).filter(k => k.length > 0);\n  }\n  staticData.users[chatId].keywords = payload.keywords;\n  staticData.users[chatId].state = 'idle';\n  // Сразу запускаем парсинг\n  action = 'trigger_parse';\n  payload.days_back = parseInt(staticData.users[chatId].days_back || '7');\n  staticData.users[chatId].days_back = null;\n} else {\n  action = 'default_reply';\n}\n\nreturn [{ json: { action, chatId, text, payload, currentState } }];"
      },
