      "parameters": {
        "jsCode": "// Обработка trigger_parse из waiting_keywords state\nconst item = $input.first().json;\nconst chatId = item.chatId;\nconst payload = item.payload || {};\n\nconst staticData = $getWorkflowStaticData('global');\nconst userState = staticData.users && staticData.users[chatId] ? staticData.users[chatId] : {};\n\nconst daysBack = payload.days_back || parseInt(userState.days_back || '7');\nconst keywords = payload.keywords || userState.keywords || [];\n\n// Сбрасываем состояние\nif (staticData.users && staticData.users[chatId]) {\n  staticData.users[chatId].state = 'idle';\n  staticData.users[chatId].days_back = null;\n  staticData.users[chatId].keywords = null;\n}\n\nreturn [{ json: { chatId, days_back: daysBack, keywords } }];"
      },
