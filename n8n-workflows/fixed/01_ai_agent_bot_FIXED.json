      "parameters": {
        "jsCode": "// Обрабатываем результаты поиска каналов\nconst searchResult = $input.first().json;\nconst channels = searchResult.channels || [];\nconst chatId = $('Подготовить нишу').first().json.chatId;\nconst niche = $('Подготовить нишу').first().json.niche;\n\n// Сохраняем каналы в staticData для дальнейшего использования\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.users) staticData.users = {};\nif (!staticData.users[chatId]) staticData.users[chatId] = {};\nstaticData.users[chatId].found_channels = channels;\nstaticData.users[chatId].current_niche = niche;\n\nconst count = channels.length;\n\nreturn [{ json: { chatId, niche, channels, count } }];"
      },
