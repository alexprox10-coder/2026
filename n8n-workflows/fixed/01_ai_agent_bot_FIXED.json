      "parameters": {
        "jsCode": "// Обработка выбора дней — устанавливаем state=waiting_keywords, сохраняем days\nconst item = $input.first().json;\nconst chatId = item.chatId;\nconst days = item.extraData.days;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.users) staticData.users = {};\nif (!staticData.users[chatId]) staticData.users[chatId] = {};\n\nstaticData.users[chatId].state = 'waiting_keywords';\nstaticData.users[chatId].days_back = days;\n\nreturn [{ json: { chatId, days, callbackQueryId: item.callbackQueryId } }];"
