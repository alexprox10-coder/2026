    {
      "parameters": {
        "jsCode": "// Разбираем callback_query\nconst item = $input.first().json;\nconst callbackQuery = item.callback_query;\nconst callbackData = callbackQuery.data || '';\nconst chatId = String(callbackQuery.message.chat.id);\nconst callbackQueryId = callbackQuery.id;\nconst messageId = callbackQuery.message.message_id;\n\n// Парсим callback data\nlet action = '';\nlet channelId = '';\nlet extraData = {};\n\nif (callbackData.startsWith('approve_')) {\n  action = 'approve';\n  channelId = callbackData.replace('approve_', '');\n} else if (callbackData.startsWith('reject_')) {\n  action = 'reject';\n  channelId = callbackData.replace('reject_', '');\n} else if (callbackData === 'start_parse') {\n  action = 'start_parse';\n} else if (callbackData === 'confirm_send') {\n  action = 'confirm_send';\n} else if (callbackData === 'cancel_send') {\n  action = 'cancel_send';\n} else if (callbackData === 'cancel_search') {\n  action = 'cancel_search';\n} else if (callbackData.startsWith('days_')) {\n  action = 'days_selected';\n  extraData.days = callbackData.replace('days_', '');\n} else {\n  action = 'unknown';\n}\n\nreturn [{\n  json: {\n    action,\n    channelId,\n    chatId,\n    callbackQueryId,\n    messageId,\n    callbackData,\n    extraData\n  }\n}];"
      },
