        "jsCode": "// Обработка callback start_parse — устанавливаем state=waiting_days\nconst item = $input.first().json;\nconst chatId = item.chatId;\n\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.users) staticData.users = {};\nif (!staticData.users[chatId]) staticData.users[chatId] = {};\n\nstaticData.users[chatId].state = 'waiting_days';\n\nreturn [{ json: { chatId, callbackQueryId: item.callbackQueryId, action: 'start_parse' } }];"
      },
