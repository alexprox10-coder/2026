      "id": "build-query-003",
      "name": "Подготовить запрос"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Вызываем главный workflow для добавления запросов\n// Главный workflow обработает запрос через Perplexity AI\n\nconst query = $input.item.json.query;\n\nreturn {\n  json: {\n    query: query,\n    status: 'prepared',\n    message: `Запрос подготовлен: ${query}`\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ],
      "id": "process-query-004",
      "name": "Обработать запрос"
    },
    {
      "parameters": {
        "workflowId": "={{ '7v3BIO39E10nUXZoLlC_H' }}",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        1180,
        300
      ],
      "id": "call-main-workflow-005",
      "name": "Вызвать главный workflow",
      "notes": "Вызывает цикл 1 главного workflow для генерации и сохранения запросов"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "success-status",
              "name": "success",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "message-output",
              "name": "message",
              "value": "={{ 'Запросы успешно добавлены для города: ' + $('Извлечь параметры').item.json.city + ', тематика: ' + $('Извлечь параметры').item.json.theme }}",
              "type": "string"
            },
            {
              "id": "added-count",
              "name": "added_queries",
              "value": "={{ $json.data?.added_count || 'неизвестно' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [
        1400,
        300
      ],
      "id": "format-response-006",
      "name": "Сформировать ответ"
    }
