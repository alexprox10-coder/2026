      "id": "d54c4bfd-ea6c-4dc4-a6ca-e6d28ed789c4",
      "name": "Claude скоринг каналов",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2400, 512]
    },
    {
      "parameters": {
        "jsCode": "const aiResp = $input.first().json;\nconst searchResp = $('Поиск каналов').first().json;\nconst nicheData = $('Парсинг профиля ниши').first().json;\nconst content = aiResp.choices[0].message.content;\nconst match = content.match(/\\[[\\s\\S]*\\]/);\nif (!match) return [];\nconst scores = JSON.parse(match[0]);\nconst channelMap = {};\n(searchResp.channels || []).forEach(function(ch){ channelMap[ch.username] = ch; });\n\n// FIX: score >= 0.8 → approved, 0.5-0.8 → pending (ручная проверка), <0.5 → auto_rejected\nreturn scores.map(function(s){\n  const ch = channelMap[s.username] || {};\n  let status = 'auto_rejected';\n  if (s.score >= 0.8) status = 'approved';\n  else if (s.score >= 0.5) status = 'pending';\n  return { json: {\n    niche_id: nicheData.niche_id,\n    niche_name: nicheData.name,\n    title: ch.title || s.username,\n    username: s.username,\n    url: 'https://t.me/' + s.username,\n    subscribers: ch.subscribers || 0,\n    description: (ch.description || '').substring(0, 200),\n    ai_score: s.score,\n    ai_reason: s.reason,\n    status: status,\n    created_at: new Date().toISOString(),\n    chat_id: nicheData.chat_id\n  }};\n});"
      },
