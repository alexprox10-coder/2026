      "parameters": {
        "jsCode": "const chatId = $json.chat_id;\nconst text = ($json.args || '').trim();\nconst state = $getWorkflowStaticData('global');\nconst dialog = state[`dialog_${chatId}`] || {};\n\nif (dialog.step === 'waiting_niche') {\n  delete state[`dialog_${chatId}`];\n  return [{ json: { chat_id: chatId, args: text, action: 'add_niche' } }];\n} else if (dialog.step === 'waiting_days') {\n  const days = parseInt(text);\n  if (isNaN(days) || days < 1 || days > 365) {\n    return [{ json: { chat_id: chatId, reply: '❌ Введите число от 1 до 365', action: 'reply' } }];\n  }\n  dialog.days_back = days;\n  dialog.step = 'waiting_keywords';\n  state[`dialog_${chatId}`] = dialog;\n  return [{ json: { chat_id: chatId, reply: '🔑 Введите ключевые слова через запятую:\\n\\nПример: аренда, квартира, сниму', action: 'reply' } }];\n} else if (dialog.step === 'waiting_keywords') {\n  const days_back = dialog.days_back;\n  delete state[`dialog_${chatId}`];\n  return [{ json: { chat_id: chatId, days_back: days_back, keywords: text, action: 'run' } }];\n} else {\n  return [{ json: { chat_id: chatId, reply: '❓ Используйте /start_parse для запуска', action: 'reply' } }];\n}"
      },
