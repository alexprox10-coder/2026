      "parameters": {
        "jsCode": "const nicheData = $('Парсинг профиля ниши').first().json;\nconst keywords = (nicheData.ai_keywords || '').split(',').slice(0, 15).map(function(k){ return k.trim(); }).filter(function(k){ return k; });\nreturn [{ json: {\n  keywords: keywords,\n  limit: 10,\n  min_subscribers: 100\n}}];"
