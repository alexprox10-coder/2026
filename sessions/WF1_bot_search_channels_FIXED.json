    {
      "parameters": {
        "jsCode": "const resp = $input.first().json;\nconst text = resp.choices[0].message.content;\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('Claude: нет JSON в ответе: ' + text.substring(0, 200));\nconst p = JSON.parse(match[0]);\nconst base = $('Извлечь команду').first().json;\nreturn [{ json: {\n  niche_id: 'niche_' + Date.now(),\n  name: base.args,\n  ai_keywords: (p.search_keywords || []).join(','),\n  lead_signals: (p.lead_signals || []).join(','),\n  spam_signals: (p.spam_signals || []).join(','),\n  niche_type: p.niche_type || '',\n  region: p.region || '',\n  first_message_template: p.first_message_template || '',\n  active: 'yes',\n  created_at: new Date().toISOString(),\n  chat_id: base.chat_id\n}}];"
      },
