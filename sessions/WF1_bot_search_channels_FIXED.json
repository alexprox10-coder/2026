      "parameters": {
        "jsCode": "const searchResp = $input.first().json;\nconst nicheData = $('Парсинг профиля ниши').first().json;\nconst channels = (searchResp.channels || []).slice(0, 30);\nconst prompt = 'Оцени Telegram каналы для ниши \"' + nicheData.name + '\".\\nКаналы: ' + JSON.stringify(channels) + '\\nВерни ТОЛЬКО валидный JSON массив: [{\"username\":\"...\",\"score\":0.85,\"reason\":\"кратко\"}]\\n0.8+ по теме, 0.5-0.8 частично, <0.5 нет';\nreturn [{ json: {\n  model: 'google/gemini-2.0-flash-001',\n  max_tokens: 3000,\n  messages: [{ role: 'user', content: prompt }]\n}}];"
      },
      "id": "19527543-bce3-46ec-b733-8a19be1571c5",
      "name": "Подготовить запрос скоринга",
