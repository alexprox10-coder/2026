    {
      "parameters": {
        "jsCode": "const msg = $json.message;\nconst text = (msg.text || '').trim();\nconst chatId = msg.chat.id;\nconst fromId = msg.from ? msg.from.id : null;\n\nlet cmd = '';\nlet args = '';\n\nif (text.startsWith('/')) {\n  const parts = text.split(' ');\n  cmd = parts[0].toLowerCase().replace(/^\\//, '');\n  args = parts.slice(1).join(' ').trim();\n} else {\n  cmd = '__text__';\n  args = text;\n}\n\nreturn [{ json: { cmd, args, chat_id: chatId, from_id: fromId, raw_text: text } }];"
      },
