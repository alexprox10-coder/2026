    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\n// FIX: .item.json — берём ТЕКУЩЕГО лида, а не всегда первого\nconst leadData = $('Фильтровать лидов с username').item.json;\nlet messageText = '';\ntry {\n  messageText = aiResult.choices[0].message.content.trim();\n} catch(e) {\n  messageText = 'Здравствуйте! Увидел ваш пост и хотел бы обсудить возможное сотрудничество. Напишите, если интересно!';\n}\nreturn [{ json: { ...leadData, generated_message: messageText } }];"
      },
