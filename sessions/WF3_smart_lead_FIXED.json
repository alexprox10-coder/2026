        "jsCode": "const allUpdated = $input.all().map(i => i.json);\nconst chat_id = allUpdated.length > 0 ? (allUpdated[0].chat_id || '7984101063') : '7984101063';\nconst total = allUpdated.length;\nconst successful = allUpdated.filter(l => l.send_success === true).length;\nconst errors = total - successful;\nreturn [{ json: { chat_id, total, successful, errors } }];"
