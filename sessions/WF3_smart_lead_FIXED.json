      "parameters": {
        "jsCode": "const allLeads = $input.all().map(i => i.json);\nconst chat_id = $('Нормализовать chat_id (превью)').first().json.chat_id;\nconst leadsWithUsername = allLeads.filter(l => l.username && l.username.trim() !== '');\nconst totalCount = leadsWithUsername.length;\nconst previewLeads = leadsWithUsername.slice(0, 3);\nif (totalCount === 0) return [{ json: { chat_id, totalCount: 0, previewText: 'Нет горячих лидов (A) с username для отправки.', noLeads: true } }];\nlet previewText = `👥 *Найдено ${totalCount} горячих лидов (A) с username*\\n\\n📋 *Примеры лидов:*\\n\\n`;\npreviewLeads.forEach((lead, idx) => {\n  const username = lead.username ? '@' + lead.username : 'нет';\n  const preview = (lead.text || '').substring(0, 150) + ((lead.text || '').length > 150 ? '...' : '');\n  previewText += `${idx + 1}. ${username}\\n   📢 ${lead.channel || ''}\\n   💬 ${preview}\\n   🎯 ${lead.ai_reason || ''}\\n\\n`;\n});\npreviewText += `\\n✉️ Буду отправлять персонализированные сообщения каждому.\\n\\nПодтверди отправку — вызови webhook /smart-lead-execute`;\nreturn [{ json: { chat_id, totalCount, previewText, noLeads: false } }];"
      },
