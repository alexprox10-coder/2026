      "parameters": {
        "jsCode": "const sendResult = $input.first().json;\n// FIX: .item.json — берём ТЕКУЩЕГО лида, а не всегда первого\nconst leadData = $('Извлечь сгенерированное сообщение').item.json;\nconst success = sendResult.success === true || sendResult.status === 'ok' || sendResult.status === 'sent';\nconst error = sendResult.error || sendResult.message || '';\nreturn [{ json: { ...leadData, send_success: success, send_error: error, contacted_at: new Date().toISOString() } }];"
