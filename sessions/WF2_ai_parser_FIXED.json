    {
      "parameters": {
        "jsCode": "const aiResult = $input.first().json;\n// FIX: .item.json — берём ТЕКУЩИЙ лид, а не всегда первый\nconst leadData = $('Фильтр пустых лидов').item.json;\nlet aiAnalysis = {is_lead: false, priority: 'C', reason: 'Не удалось проанализировать', intent: 'other', urgency: 'low'};\ntry {\n  const content = aiResult.choices[0].message.content;\n  const cleaned = content.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n  aiAnalysis = JSON.parse(cleaned);\n} catch(e) {\n  try {\n    const content = aiResult.choices[0].message.content;\n    const match = content.match(/\\{[\\s\\S]*\\}/);\n    if (match) aiAnalysis = JSON.parse(match[0]);\n  } catch(e2) {}\n}\nreturn [{ json: {\n  ...leadData,\n  is_lead: aiAnalysis.is_lead,\n  ai_priority: aiAnalysis.priority || 'C',\n  ai_reason: aiAnalysis.reason || '',\n  ai_intent: aiAnalysis.intent || 'other',\n  ai_urgency: aiAnalysis.urgency || 'low',\n  status: 'new',\n  analyzed_at: new Date().toISOString()\n} }];"
      },
