    {
      "parameters": {
        "jsCode": "let days_back = 7;\nlet keywords = [];\nlet chat_id = '7984101063';\nconst allItems = $input.all();\nif (allItems.length > 0) {\n  const item = allItems[0].json;\n  let raw_keywords = [];\n  if (item.body) {\n    days_back = parseInt(item.body.days_back || 7);\n    raw_keywords = item.body.keywords || [];\n    chat_id = item.body.chat_id || '7984101063';\n  } else if (item.days_back !== undefined) {\n    days_back = parseInt(item.days_back || 7);\n    raw_keywords = item.keywords || [];\n    chat_id = item.chat_id || '7984101063';\n  }\n  if (typeof raw_keywords === 'string' && raw_keywords.trim()) {\n    keywords = raw_keywords.split(',').map(k => k.trim()).filter(k => k);\n  } else if (Array.isArray(raw_keywords)) {\n    keywords = raw_keywords;\n  }\n}\nreturn [{ json: { days_back, keywords, chat_id } }];"
      },
