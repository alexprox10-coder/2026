    {
      "parameters": {
        "jsCode": "const sourcesItems = $('Получить источники (approved)').all();\nconst nichesItems = $('Получить ниши').all();\nconst paramsItem = $('Нормализовать входные данные').first().json;\nconst days_back = paramsItem.days_back || 7;\nconst chat_id = paramsItem.chat_id || '7984101063';\nlet keywords_from_request = paramsItem.keywords || [];\nconst channels = sourcesItems.map(item => item.json).filter(s => s.channel_url || s.username).map(s => {\n  if (s.username) return s.username;\n  return (s.channel_url || '').trim().replace(/^@/, '').replace(/^https:\\/\\/t\\.me\\//i, '');\n}).filter(Boolean);\nconst niche_keywords = [];\nconst lead_signals = [];\nnichesItems.forEach(item => {\n  const n = item.json;\n  // FIX: поле называется ai_keywords (не keywords)\n  if (n.ai_keywords) {\n    const kws = Array.isArray(n.ai_keywords) ? n.ai_keywords : String(n.ai_keywords).split(',');\n    kws.forEach(k => { if (k.trim()) niche_keywords.push(k.trim()); });\n  }\n  if (n.lead_signals) {\n    const ls = Array.isArray(n.lead_signals) ? n.lead_signals : String(n.lead_signals).split(',');\n    ls.forEach(s => { if (s.trim()) lead_signals.push(s.trim()); });\n  }\n});\nconst keywords = keywords_from_request.length > 0 ? keywords_from_request : niche_keywords;\nif (channels.length === 0) throw new Error('Нет одобренных каналов для парсинга!');\nreturn [{ json: { channels, keywords, lead_signals, days_back, chat_id, total_channels: channels.length } }];"
      },
