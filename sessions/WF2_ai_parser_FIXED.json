    {
      "parameters": {
        "jsCode": "// FIX: агрегируем ВСЕ лиды за один запуск через Merge-ноду\nconst allLeads = $input.all().map(i => i.json);\nconst chat_id = $('Нормализовать входные данные').first().json.chat_id || '7984101063';\nconst total = allLeads.length;\nconst hotA = allLeads.filter(l => l.ai_priority === 'A' && (l.is_lead === true || l.is_lead === 'TRUE')).length;\nconst warmB = allLeads.filter(l => l.ai_priority === 'B').length;\nconst coldC = allLeads.filter(l => l.ai_priority === 'C' || !l.ai_priority).length;\nreturn [{ json: { chat_id, total_posts: total, hot_a: hotA, warm_b: warmB, cold_c: coldC } }];"
      },
