    {
      "parameters": {
        "jsCode": "const parserResult = $input.first().json;\nconst paramsItem = $('Нормализовать входные данные').first().json;\nconst posts = parserResult.posts || parserResult.messages || parserResult.results || [];\nconst chat_id = paramsItem.chat_id || '7984101063';\nconst keywords = paramsItem.keywords || [];\nconst lead_signals = $('Сформировать запрос парсера').first().json.lead_signals || [];\nif (posts.length === 0) return [{ json: { empty: true, chat_id, message: 'Парсер не вернул постов' } }];\nconst leads = posts.map(post => ({\n  post_url: post.url || post.post_url || '',\n  channel: post.channel || post.channel_username || '',\n  author: post.author || post.from_user || '',\n  username: post.username || post.user_username || '',\n  text: post.text || post.message || '',\n  date: post.date || post.timestamp || '',\n  views: post.views || 0,\n  chat_id,\n  keywords_found: keywords.filter(k => (post.text || '').toLowerCase().includes(k.toLowerCase())),\n  signals_found: lead_signals.filter(s => (post.text || '').toLowerCase().includes(s.toLowerCase()))\n}));\nreturn leads.map(lead => ({ json: lead }));"
      },
