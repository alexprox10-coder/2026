    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  try {\n    const data = item.json.body || item.json;\n    \n    let url = String(data.url || '').trim();\n    const companyName = String(data.company_name || '').trim();\n    const source = String(data.source || 'api').trim();\n    \n    // Валидация URL\n    if (!url) {\n      results.push({\n        json: {\n          success: false,\n          error: 'URL is required',\n          code: 'MISSING_URL'\n        }\n      });\n      continue;\n    }\n    \n    // Добавление протокола если отсутствует\n    if (!url.match(/^https?:\\/\\//i)) {\n      url = 'https://' + url;\n    }\n    \n    // Проверка валидности URL\n    try {\n      const urlObj = new URL(url);\n      \n      // Проверка на допустимые протоколы\n      if (!['http:', 'https:'].includes(urlObj.protocol)) {\n        results.push({\n          json: {\n            success: false,\n            error: 'Invalid URL protocol. Only HTTP and HTTPS are allowed',\n            code: 'INVALID_PROTOCOL'\n          }\n        });\n        continue;\n      }\n      \n      // Нормализация URL (удаление trailing slash)\n      url = urlObj.href.replace(/\\/$/, '');\n      \n    } catch (error) {\n      results.push({\n        json: {\n          success: false,\n          error: `Invalid URL format: ${error.message}`,\n          code: 'INVALID_URL'\n        }\n      });\n      continue;\n    }\n    \n    // Успешная валидация\n    results.push({\n      json: {\n        url: url,\n        company_name: companyName || 'Unknown',\n        source: source,\n        created_at: new Date().toISOString(),\n        status: 0,\n        validation: 'passed'\n      }\n    });\n    \n  } catch (error) {\n    results.push({\n      json: {\n        success: false,\n        error: `Processing error: ${error.message}`,\n        code: 'PROCESSING_ERROR'\n      }\n    });\n  }\n}\n\nreturn results;"
      },
